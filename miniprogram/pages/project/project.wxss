page { background: #F5F5F7; }

.box { padding: 24rpx 40rpx calc(160rpx + env(safe-area-inset-bottom)); background: #F5F5F7; animation: fadeIn 0.2s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }

.tip { text-align: center; padding-top: 200rpx; color: #86868B; font-size: 28rpx; }
.tip-icon-wrap { width: 120rpx; height: 120rpx; border-radius: 50%; background: #F0F4FF; display: flex; align-items: center; justify-content: center; margin: 0 auto 28rpx; }
.tip-icon-txt { font-size: 48rpx; font-weight: 600; color: #0071E3; }
.tip-text { font-weight: 500; color: #0071E3; }

.card {
  border-radius: 24rpx;
  background: #fff; margin-bottom: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
  transition: transform 0.2s ease;
}
.card:active { transform: scale(0.98); }
.card-body { padding: 40rpx 36rpx; }

.card-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.card-name { font-size: 30rpx; font-weight: 600; color: #1D1D1F; }
.card-ft { display: flex; justify-content: space-between; align-items: center; }
.card-date { font-size: 22rpx; color: #86868B; font-weight: 500; }
.card-num { font-size: 22rpx; color: #0071E3; font-weight: 600; }
.card-btns { display: flex; gap: 12rpx; }
.card-del { font-size: 24rpx; color: #FF3B30; padding: 10rpx 24rpx; border-radius: 12rpx; background: #FFF5F5; font-weight: 600; border: 1rpx solid rgba(255,59,48,0.12); }
.card-restore { font-size: 24rpx; color: #34C759; padding: 10rpx 24rpx; border-radius: 12rpx; background: #F0FFF0; font-weight: 600; border: 1rpx solid rgba(52,199,89,0.12); }
.card-perma { font-size: 24rpx; color: #FF3B30; padding: 10rpx 24rpx; border-radius: 12rpx; background: #FFF5F5; font-weight: 600; border: 1rpx solid rgba(255,59,48,0.12); }

.card-imgs { display: flex; gap: 8rpx; margin-bottom: 12rpx; }
.card-img { width: 96rpx; height: 96rpx; border-radius: 12rpx; border: 1rpx solid rgba(0,0,0,0.04); }

.file-entry {
  display: flex; align-items: center; padding: 30rpx 32rpx; margin-bottom: 20rpx;
  font-size: 28rpx; color: #0071E3; background: #fff; border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  font-weight: 600;
  transition: transform 0.2s ease, opacity 0.2s ease;
}
.file-entry:active { opacity: 0.7; transform: scale(0.98); }

.files-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 2000; backdrop-filter: blur(4rpx); }
.files-modal {
  position: fixed; top: 15%; left: 40rpx; right: 40rpx; bottom: 15%;
  background: #fff; border-radius: 24rpx; z-index: 2001;
  display: flex; flex-direction: column; overflow: hidden;
  animation: scaleIn 0.2s ease;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.08);
}
@keyframes scaleIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
.files-hd { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 32rpx; border-bottom: 1rpx solid #F5F5F7; }
.files-title { font-size: 32rpx; font-weight: 700; color: #1D1D1F; }
.files-close { font-size: 34rpx; color: #86868B; padding: 10rpx; font-weight: 300; }
.files-body { flex: 1; padding: 8rpx 0; }
.files-item { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 32rpx; border-bottom: 1rpx solid #F5F5F7; transition: background 0.15s ease; }
.files-item:active { background: #F5F5F7; }
.files-name { font-size: 28rpx; color: #1D1D1F; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
.files-arrow { font-size: 38rpx; color: #0071E3; margin-left: 12rpx; font-weight: 300; }
.files-empty { text-align: center; color: #86868B; font-size: 26rpx; padding-top: 80rpx; font-weight: 500; }

/* Dark Mode */
.box.dark { background: #000; }
.dark .tip { color: #98989D; }
.dark .tip-icon-wrap { background: #1C1C1E; }
.dark .tip-icon-txt { color: #0A84FF; }
.dark .tip-text { color: #0A84FF; }
.dark .card { background: #1C1C1E; box-shadow: none; border: 1rpx solid rgba(255,255,255,0.06); }
.dark .card-name { color: #F5F5F7; }
.dark .card-date { color: #98989D; }
.dark .card-num { color: #0A84FF; }
.dark .card-del { background: rgba(255,59,48,0.15); color: #FF453A; border: 1rpx solid rgba(255,59,48,0.2); }
.dark .card-restore { background: rgba(52,199,89,0.15); color: #30D158; border: 1rpx solid rgba(52,199,89,0.2); }
.dark .card-perma { background: rgba(255,59,48,0.15); color: #FF453A; border: 1rpx solid rgba(255,59,48,0.2); }
.dark .card-img { border-color: rgba(255,255,255,0.06); }
.dark .file-entry { background: #1C1C1E; color: #0A84FF; box-shadow: none; }
.dark .files-modal { background: #1C1C1E; box-shadow: none; }
.dark .files-title { color: #F5F5F7; }
.dark .files-close { color: #98989D; }
.dark .files-item { border-bottom-color: #2C2C2E; }
.dark .files-name { color: #F5F5F7; }
.dark .files-hd { border-bottom-color: #2C2C2E; }
.dark .files-item:active { background: #2C2C2E; }
.dark .files-arrow { color: #0A84FF; }
.dark .files-mask { background: rgba(0,0,0,0.6); }
