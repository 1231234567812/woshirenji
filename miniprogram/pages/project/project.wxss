page { background: #f0f4f8; }

.box { padding: 24rpx 28rpx calc(160rpx + env(safe-area-inset-bottom)); background: #f0f4f8; animation: fadeIn 0.3s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(30rpx); } to { opacity: 1; transform: translateY(0); } }

.tip { text-align: center; padding-top: 200rpx; color: #8892b0; font-size: 28rpx; }
.tip-icon { display: block; font-size: 80rpx; line-height: 1; margin-bottom: 16rpx; }

.card {
  display: flex; border-radius: 20rpx; overflow: hidden;
  background: #fff; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.05);
  animation: cardIn 0.3s ease both;
}
@keyframes cardIn { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }
.card:nth-child(1) { animation-delay: 0s; }
.card:nth-child(2) { animation-delay: 0.04s; }
.card:nth-child(3) { animation-delay: 0.08s; }
.card:nth-child(4) { animation-delay: 0.12s; }
.card:nth-child(5) { animation-delay: 0.16s; }
.card-accent { width: 8rpx; flex-shrink: 0; background: linear-gradient(180deg, #667eea 0%, #764ba2 100%); }
.card-body { flex: 1; padding: 24rpx; }

.card-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.card-name { font-size: 28rpx; font-weight: 600; color: #1a1a2e; }
.card-ft { display: flex; justify-content: space-between; align-items: center; }
.card-date { font-size: 20rpx; color: #8892b0; }
.card-num { font-size: 20rpx; color: #667eea; }
.card-btns { display: flex; gap: 12rpx; }
.card-del { font-size: 24rpx; color: #e74c3c; padding: 8rpx 20rpx; border-radius: 10rpx; background: #fde8e8; }
.card-restore { font-size: 24rpx; color: #27ae60; padding: 8rpx 20rpx; border-radius: 10rpx; background: #e8f8ef; }
.card-perma { font-size: 24rpx; color: #e74c3c; padding: 8rpx 20rpx; border-radius: 10rpx; background: #fde8e8; }

.card-imgs { display: flex; gap: 6rpx; margin-bottom: 10rpx; }
.card-img { width: 90rpx; height: 90rpx; border-radius: 12rpx; }

.file-entry {
  display: flex; align-items: center; padding: 28rpx 32rpx; margin-bottom: 20rpx;
  font-size: 28rpx; color: #667eea; background: #fff; border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.file-entry:active { opacity: 0.7; }

.files-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 2000; }
.files-modal {
  position: fixed; top: 15%; left: 40rpx; right: 40rpx; bottom: 15%;
  background: #fff; border-radius: 24rpx; z-index: 2001;
  display: flex; flex-direction: column; overflow: hidden;
  animation: scaleIn 0.25s ease;
  box-shadow: 0 24rpx 64rpx rgba(0,0,0,0.15);
}
@keyframes scaleIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
.files-hd { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx; border-bottom: 1rpx solid #f0f0f0; }
.files-title { font-size: 30rpx; font-weight: 700; color: #1a1a2e; }
.files-close { font-size: 32rpx; color: #8892b0; padding: 10rpx; }
.files-body { flex: 1; padding: 8rpx 0; }
.files-item { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx; border-bottom: 1rpx solid #f5f5f5; }
.files-item:active { background: #f8f8f8; }
.files-name { font-size: 28rpx; color: #1a1a2e; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.files-arrow { font-size: 36rpx; color: #c0c0c0; margin-left: 12rpx; }
.files-empty { text-align: center; color: #8892b0; font-size: 26rpx; padding-top: 80rpx; }

/* 深色模式 */
.box.dark { background: #0d0d1a; }
.dark .card { background: #161625; box-shadow: none; }
.dark .card-accent { background: linear-gradient(180deg, #4a5a8a 0%, #5a3a7a 100%); }
.dark .card-name { color: #e0e0e0; }
.dark .card-date { color: #6d7a9c; }
.dark .card-num { color: #8b9dc3; }
.dark .card-del { background: #2a1a1a; }
.dark .card-restore { background: #1a2a1a; }
.dark .card-perma { background: #2a1a1a; }
.dark .file-entry { background: #161625; color: #8b9dc3; box-shadow: none; }
.dark .tip { color: #6d7a9c; }
.dark .tip-icon { color: #444; }
.dark .files-modal { background: #161625; box-shadow: none; }
.dark .files-title { color: #e0e0e0; }
.dark .files-close { color: #6d7a9c; }
.dark .files-item { border-bottom-color: #222240; }
.dark .files-name { color: #e0e0e0; }
.dark .files-hd { border-bottom-color: #222240; }
.dark .files-item:active { background: #1a1a2e; }
.dark .files-arrow { color: #444; }
