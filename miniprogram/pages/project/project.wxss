page { background: #f1faee; }

.box { padding: 24rpx 24rpx calc(160rpx + env(safe-area-inset-bottom)); background: #f1faee; animation: fadeIn 0.3s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(30rpx); } to { opacity: 1; transform: translateY(0); } }

.tip { text-align: center; padding-top: 200rpx; color: #999; font-size: 28rpx; }
.tip-icon { display: block; font-size: 80rpx; line-height: 1; margin-bottom: 16rpx; }

.card {
  padding: 16rpx;
  margin-bottom: 14rpx;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
  animation: cardIn 0.3s ease both;
}
@keyframes cardIn { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }
.card:nth-child(1) { animation-delay: 0s; }
.card:nth-child(2) { animation-delay: 0.04s; }
.card:nth-child(3) { animation-delay: 0.08s; }
.card:nth-child(4) { animation-delay: 0.12s; }
.card:nth-child(5) { animation-delay: 0.16s; }

.card-hd {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 10rpx;
}
.card-name { font-size: 26rpx; font-weight: 600; color: #1d3557; }
.card-ft { display: flex; justify-content: space-between; align-items: center; }
.card-date { font-size: 20rpx; color: #999; }
.card-num { font-size: 20rpx; color: #457b9d; }
.card-btns { display: flex; gap: 12rpx; }
.card-del { font-size: 28rpx; color: #e74c3c; padding: 8rpx 20rpx; border-radius: 10rpx; background: #fde8e8; }
.card-restore { font-size: 28rpx; color: #27ae60; padding: 8rpx 20rpx; border-radius: 10rpx; background: #e8f8ef; }
.card-perma { font-size: 28rpx; color: #e74c3c; padding: 8rpx 20rpx; border-radius: 10rpx; background: #fde8e8; }

.card-imgs { display: flex; gap: 6rpx; margin-bottom: 10rpx; }
.card-img { width: 90rpx; height: 90rpx; border-radius: 8rpx; }

.file-entry {
  text-align: center; padding: 20rpx; margin-bottom: 16rpx;
  font-size: 26rpx; color: #457b9d; background: #fff; border-radius: 14rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.04);
}
.file-entry:active { opacity: 0.7; }

/* 文件浏览弹窗 */
.files-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); z-index: 2000; }
.files-modal {
  position: fixed; top: 15%; left: 40rpx; right: 40rpx; bottom: 15%;
  background: #fff; border-radius: 20rpx; z-index: 2001;
  display: flex; flex-direction: column; overflow: hidden;
  animation: scaleIn 0.25s ease;
}
@keyframes scaleIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
.files-hd {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 30rpx; border-bottom: 1rpx solid #eee;
}
.files-title { font-size: 30rpx; font-weight: 600; color: #1d3557; }
.files-close { font-size: 32rpx; color: #999; padding: 10rpx; }
.files-body { flex: 1; padding: 16rpx 0; }
.files-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 30rpx; border-bottom: 1rpx solid #f5f5f5;
}
.files-item:active { background: #f8f8f8; }
.files-name { font-size: 28rpx; color: #1d3557; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.files-arrow { font-size: 36rpx; color: #ccc; margin-left: 12rpx; }
.files-empty { text-align: center; color: #999; font-size: 26rpx; padding-top: 80rpx; }

/* 深色模式 */
.box.dark { background: #1a1a2e; }
.dark .card { background: #16213e; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.2); }
.dark .card-name { color: #e0e0e0; }
.dark .card-date { color: #888; }
.dark .card-num { color: #a8dadc; }
.dark .card-del { background: #3d1a1a; }
.dark .card-restore { background: #1a3d2a; }
.dark .card-perma { background: #3d1a1a; }
.dark .file-entry { background: #16213e; color: #a8dadc; }
.dark .tip { color: #888; }
.dark .tip-icon { color: #555; }
.dark .files-modal { background: #16213e; }
.dark .files-title { color: #e0e0e0; }
.dark .files-item { border-bottom-color: #2a2a4a; }
.dark .files-name { color: #e0e0e0; }
.dark .files-hd { border-bottom-color: #2a2a4a; }
.dark .files-item:active { background: #1a1a2e; }
.dark .files-close { color: #777; }
.dark .files-arrow { color: #666; }

