page { background: #f0f4f8; }

.box { padding: 24rpx 28rpx calc(160rpx + env(safe-area-inset-bottom)); background: #f0f4f8; animation: fadeIn 0.4s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(30rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8rpx); } }

.tip { text-align: center; padding-top: 200rpx; color: #8892b0; font-size: 28rpx; }
.tip-icon { display: block; font-size: 100rpx; line-height: 1; margin-bottom: 20rpx; animation: float 3s ease-in-out infinite; }
.tip-text { font-weight: 500; color: #667eea; }

.card {
  display: flex; border-radius: 24rpx; overflow: hidden;
  background: #fff; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 28rpx rgba(0,0,0,0.06);
  animation: cardIn 0.3s ease both;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  border: 1rpx solid rgba(0,0,0,0.03);
}
@keyframes cardIn { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }
.card:nth-child(1) { animation-delay: 0s; }
.card:nth-child(2) { animation-delay: 0.04s; }
.card:nth-child(3) { animation-delay: 0.08s; }
.card:nth-child(4) { animation-delay: 0.12s; }
.card:nth-child(5) { animation-delay: 0.16s; }
.card:active { transform: scale(0.98); box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08); }
.card-accent { width: 10rpx; flex-shrink: 0; background: linear-gradient(180deg, #667eea 0%, #764ba2 100%); }
.card-body { flex: 1; padding: 28rpx; }

.card-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.card-name { font-size: 30rpx; font-weight: 700; color: #1a1a2e; letter-spacing: 1rpx; }
.card-ft { display: flex; justify-content: space-between; align-items: center; }
.card-date { font-size: 22rpx; color: #8892b0; font-weight: 500; }
.card-num { font-size: 22rpx; color: #667eea; font-weight: 600; }
.card-btns { display: flex; gap: 12rpx; }
.card-del { font-size: 24rpx; color: #e74c3c; padding: 10rpx 24rpx; border-radius: 12rpx; background: linear-gradient(135deg, #fde8e8, #fce4e4); font-weight: 600; border: 1rpx solid rgba(231,76,60,0.1); }
.card-restore { font-size: 24rpx; color: #27ae60; padding: 10rpx 24rpx; border-radius: 12rpx; background: linear-gradient(135deg, #e8f8ef, #d4f5e4); font-weight: 600; border: 1rpx solid rgba(39,174,96,0.1); }
.card-perma { font-size: 24rpx; color: #e74c3c; padding: 10rpx 24rpx; border-radius: 12rpx; background: linear-gradient(135deg, #fde8e8, #fce4e4); font-weight: 600; border: 1rpx solid rgba(231,76,60,0.1); }

.card-imgs { display: flex; gap: 8rpx; margin-bottom: 12rpx; }
.card-img { width: 96rpx; height: 96rpx; border-radius: 16rpx; border: 1rpx solid rgba(0,0,0,0.04); }

.file-entry {
  display: flex; align-items: center; padding: 30rpx 32rpx; margin-bottom: 20rpx;
  font-size: 28rpx; color: #667eea; background: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(240,244,248,0.95)); border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.05);
  font-weight: 600;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(102,126,234,0.08);
  transition: transform 0.25s ease, opacity 0.25s ease;
}
.file-entry:active { opacity: 0.7; transform: scale(0.98); }

.files-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 2000; backdrop-filter: blur(4rpx); }
.files-modal {
  position: fixed; top: 15%; left: 40rpx; right: 40rpx; bottom: 15%;
  background: #fff; border-radius: 28rpx; z-index: 2001;
  display: flex; flex-direction: column; overflow: hidden;
  animation: scaleIn 0.3s cubic-bezier(0.34,1.56,0.64,1);
  box-shadow: 0 32rpx 80rpx rgba(0,0,0,0.18);
}
@keyframes scaleIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
.files-hd { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 32rpx; border-bottom: 1rpx solid #f0f0f0; }
.files-title { font-size: 32rpx; font-weight: 800; color: #1a1a2e; letter-spacing: 1rpx; }
.files-close { font-size: 34rpx; color: #8892b0; padding: 10rpx; font-weight: 300; }
.files-body { flex: 1; padding: 8rpx 0; }
.files-item { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 32rpx; border-bottom: 1rpx solid #f5f5f5; transition: background 0.15s ease; }
.files-item:active { background: #f0f4f8; }
.files-name { font-size: 28rpx; color: #1a1a2e; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
.files-arrow { font-size: 38rpx; color: #667eea; margin-left: 12rpx; font-weight: 300; }
.files-empty { text-align: center; color: #8892b0; font-size: 26rpx; padding-top: 80rpx; font-weight: 500; }

/* 深色模式 */
.box.dark { background: #0d0d1a; }
.dark .tip { color: #6d7a9c; }
.dark .tip-icon { color: #333; }
.dark .tip-text { color: #8b9dc3; }
.dark .card { background: #161625; box-shadow: none; border: 1rpx solid rgba(255,255,255,0.04); }
.dark .card-accent { background: linear-gradient(180deg, #4a5a8a 0%, #5a3a7a 100%); }
.dark .card-name { color: #e0e0e0; }
.dark .card-date { color: #6d7a9c; }
.dark .card-num { color: #8b9dc3; }
.dark .card-del { background: rgba(231,76,60,0.12); border: 1rpx solid rgba(231,76,60,0.15); }
.dark .card-restore { background: rgba(39,174,96,0.12); border: 1rpx solid rgba(39,174,96,0.15); }
.dark .card-perma { background: rgba(231,76,60,0.12); border: 1rpx solid rgba(231,76,60,0.15); }
.dark .card-img { border-color: rgba(255,255,255,0.05); }
.dark .file-entry { background: linear-gradient(135deg, rgba(22,22,37,0.95), rgba(13,13,26,0.95)); color: #8b9dc3; box-shadow: none; border: 1rpx solid rgba(255,255,255,0.05); }
.dark .files-modal { background: #161625; box-shadow: none; }
.dark .files-title { color: #e0e0e0; }
.dark .files-close { color: #6d7a9c; }
.dark .files-item { border-bottom-color: #222240; }
.dark .files-name { color: #e0e0e0; }
.dark .files-hd { border-bottom-color: #222240; }
.dark .files-item:active { background: #1a1a2e; }
.dark .files-arrow { color: #667eea; }
.dark .files-mask { background: rgba(0,0,0,0.6); }
