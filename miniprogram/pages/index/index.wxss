page { background: #f0f4f8; }
.box { padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom)); background: #f0f4f8; animation: fadeIn 0.3s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes slideUp { from { opacity: 0; transform: translateY(60rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes scaleIn { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
@keyframes cardIn { from { opacity: 0; transform: translateY(30rpx); } to { opacity: 1; transform: translateY(0); } }
.work-view { animation: scaleIn 0.3s ease; }
.hero { text-align: center; padding: 60rpx 0 40rpx; }
.hero-icon-wrap { width: 120rpx; height: 120rpx; border-radius: 32rpx; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 24rpx; box-shadow: 0 16rpx 48rpx rgba(102,126,234,0.35); }
.hero-icon { font-size: 56rpx; color: #fff; line-height: 1; }
.hero-title { display: block; font-size: 40rpx; font-weight: 700; color: #1a1a2e; letter-spacing: 2rpx; margin-bottom: 12rpx; }
.hero-sub { display: block; font-size: 26rpx; color: #8892b0; letter-spacing: 1rpx; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-bottom: 28rpx; }
.quick-card { background: #fff; border-radius: 24rpx; padding: 32rpx 24rpx; display: flex; flex-direction: column; align-items: center; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04); transition: all 0.2s ease; }
.quick-press { transform: scale(0.96); opacity: 0.85; }
.quick-icon-box { width: 88rpx; height: 88rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 16rpx; }
.qi-1 { background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%); }
.qi-2 { background: linear-gradient(135deg, #fbc2eb 0%, #a6c1ee 100%); }
.qi-3 { background: linear-gradient(135deg, #fddb92 0%, #d1fdff 100%); }
.qi-4 { background: linear-gradient(135deg, #c1dfc4 0%, #deecdd 100%); }
.quick-emoji { font-size: 40rpx; line-height: 1; }
.quick-label { font-size: 26rpx; font-weight: 600; color: #1a1a2e; }
.browse-bar { display: flex; align-items: center; padding: 28rpx 32rpx; margin-bottom: 28rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04); }
.browse-press { opacity: 0.7; }
.browse-icon { font-size: 36rpx; margin-right: 16rpx; }
.browse-text { flex: 1; font-size: 28rpx; color: #1a1a2e; font-weight: 500; }
.browse-arrow { font-size: 32rpx; color: #c0c0c0; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; padding: 0 4rpx; }
.section-title { font-size: 30rpx; font-weight: 700; color: #1a1a2e; }
.section-count { font-size: 24rpx; color: #8892b0; }
.card { display: flex; border-radius: 20rpx; overflow: hidden; background: #fff; margin-bottom: 20rpx; box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.05); animation: cardIn 0.35s ease both; }
.card:nth-child(1) { animation-delay: 0s; }
.card:nth-child(2) { animation-delay: 0.05s; }
.card:nth-child(3) { animation-delay: 0.1s; }
.card:nth-child(4) { animation-delay: 0.15s; }
.card:nth-child(5) { animation-delay: 0.2s; }
.card-accent { width: 8rpx; flex-shrink: 0; background: linear-gradient(180deg, #667eea 0%, #764ba2 100%); }
.card-body { flex: 1; padding: 24rpx; }
.card-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.card-name { font-size: 28rpx; font-weight: 600; color: #1a1a2e; }
.card-date { font-size: 22rpx; color: #8892b0; }
.card-imgs { display: flex; gap: 8rpx; margin-bottom: 12rpx; }
.card-img { width: 130rpx; height: 130rpx; border-radius: 12rpx; }
.card-ft { display: flex; justify-content: space-between; align-items: center; }
.card-num { font-size: 24rpx; color: #667eea; }
.card-del { font-size: 24rpx; color: #e74c3c; padding: 8rpx 20rpx; border-radius: 10rpx; background: #fde8e8; }
.empty-state { text-align: center; padding: 80rpx 0; }
.empty-icon { display: block; font-size: 100rpx; margin-bottom: 24rpx; }
.empty-text { display: block; font-size: 30rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 12rpx; }
.empty-hint { display: block; font-size: 24rpx; color: #8892b0; }
.fab { position: fixed; bottom: calc(180rpx + env(safe-area-inset-bottom)); right: 40rpx; width: 112rpx; height: 112rpx; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); box-shadow: 0 12rpx 36rpx rgba(102,126,234,0.45); display: flex; align-items: center; justify-content: center; z-index: 999; }
.fab-press { transform: scale(0.9); opacity: 0.8; }
.fab-txt { font-size: 52rpx; color: #fff; line-height: 1; font-weight: 300; }
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 0 28rpx; }
.back { width: 64rpx; height: 64rpx; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #667eea; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.back-press { opacity: 0.6; }
.topbar-title { font-size: 32rpx; font-weight: 700; color: #1a1a2e; }
.topbar-folder { width: 64rpx; height: 64rpx; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; font-size: 28rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); }
.btn { height: 92rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx; box-shadow: 0 8rpx 24rpx rgba(102,126,234,0.3); transition: all 0.2s ease; }
.btn-press { transform: scale(0.97); opacity: 0.85; }
.btn-cvt { background: linear-gradient(135deg, #1a1a2e 0%, #2d2d5e 100%); box-shadow: 0 8rpx 24rpx rgba(26,26,46,0.3); }
.btn-loading { opacity: 0.6; pointer-events: none; }
.quality-bar { display: flex; align-items: center; justify-content: space-between; padding: 20rpx 28rpx; margin-bottom: 20rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.quality-label { font-size: 26rpx; color: #8892b0; font-weight: 500; }
.quality-opts { display: flex; gap: 12rpx; }
.quality-opt { font-size: 24rpx; color: #8892b0; padding: 10rpx 28rpx; border-radius: 12rpx; background: #f0f4f8; transition: all 0.2s ease; }
.quality-opt.active { color: #fff; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); font-weight: 600; }
.progress-wrap { margin-bottom: 20rpx; padding: 24rpx 28rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.progress-bar { height: 12rpx; border-radius: 6rpx; background: #e8ecf1; overflow: hidden; margin-bottom: 12rpx; }
.progress-fill { height: 100%; border-radius: 6rpx; background: linear-gradient(90deg, #667eea 0%, #764ba2 100%); transition: width 0.3s ease; }
.progress-text { font-size: 22rpx; color: #8892b0; text-align: center; display: block; }
.preview { position: relative; height: 400rpx; border-radius: 20rpx; overflow: hidden; margin-bottom: 24rpx; background: #e8ecf1; }
.preview-img { width: 100%; height: 100%; }
.preview-tip { position: absolute; bottom: 16rpx; right: 16rpx; font-size: 20rpx; color: #fff; padding: 8rpx 20rpx; border-radius: 10rpx; background: rgba(0,0,0,0.45); }
.code-box { border-radius: 20rpx; overflow: hidden; background: #1a1a2e; margin-bottom: 24rpx; }
.code-hd { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 28rpx; border-bottom: 1rpx solid rgba(255,255,255,0.08); }
.code-label { font-size: 24rpx; color: #a8dadc; }
.code-actions { display: flex; gap: 12rpx; }
.code-copy { font-size: 24rpx; color: #f1faee; padding: 8rpx 20rpx; border-radius: 10rpx; background: #2d2d5e; }
.code-body { height: 400rpx; padding: 24rpx; }
.code-text { font-size: 22rpx; color: #a8dadc; word-break: break-all; line-height: 1.6; }
.file-pick { text-align: right; margin-bottom: 16rpx; }
.file-pick text { font-size: 26rpx; color: #667eea; padding: 12rpx 28rpx; border-radius: 12rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.file-pick:active text { opacity: 0.7; }
.text-in { width: 100%; height: 300rpx; padding: 28rpx; border-radius: 20rpx; background: #fff; font-size: 28rpx; color: #1a1a2e; margin-bottom: 24rpx; box-sizing: border-box; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04); }
.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); z-index: 1000; }
.menu { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 20rpx 32rpx 60rpx; z-index: 1001; animation: slideUp 0.3s ease; }
.menu-hd { text-align: center; padding: 16rpx 0 28rpx; }
.menu-title { font-size: 30rpx; font-weight: 700; color: #1a1a2e; }
.menu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-bottom: 24rpx; }
.menu-card { display: flex; flex-direction: column; align-items: center; padding: 28rpx 16rpx; border-radius: 20rpx; background: #f5f7fb; transition: all 0.2s ease; }
.menu-card-press { transform: scale(0.96); opacity: 0.8; }
.menu-card-icon { width: 72rpx; height: 72rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; margin-bottom: 12rpx; }
.mc-1 { background: linear-gradient(135deg, #a8edea, #fed6e3); }
.mc-2 { background: linear-gradient(135deg, #fbc2eb, #a6c1ee); }
.mc-3 { background: linear-gradient(135deg, #fddb92, #d1fdff); }
.mc-4 { background: linear-gradient(135deg, #c1dfc4, #deecdd); }
.mc-5 { background: linear-gradient(135deg, #d4fc79, #96e6a1); }
.menu-card-label { font-size: 24rpx; font-weight: 600; color: #1a1a2e; }
.menu-cancel { margin-top: 8rpx; text-align: center; font-size: 28rpx; color: #8892b0; padding: 20rpx 0; }
.history { margin-top: 16rpx; }
.h-title { font-size: 28rpx; color: #1a1a2e; font-weight: 700; margin-bottom: 16rpx; display: block; }
.h-list { white-space: nowrap; }
.h-item { display: inline-block; margin-right: 16rpx; text-align: center; vertical-align: top; }
.h-img { width: 140rpx; height: 140rpx; border-radius: 16rpx; display: block; }
.h-text-card { width: 140rpx; height: 140rpx; border-radius: 16rpx; background: linear-gradient(135deg, #e8edff, #f0e8ff); display: flex; align-items: center; justify-content: center; padding: 16rpx; box-sizing: border-box; }
.h-text-preview { font-size: 22rpx; color: #667eea; word-break: break-all; line-height: 1.4; }
.h-size { font-size: 20rpx; color: #8892b0; margin-top: 6rpx; display: block; }
.h-item-main { display: block; }
.h-item-ft { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-top: 6rpx; }
.h-copy { font-size: 18rpx; color: #667eea; padding: 4rpx 12rpx; border-radius: 8rpx; background: rgba(102,126,234,0.1); }
.one-click-copy { text-align: center; padding: 16rpx 0; }
.one-click-text { font-size: 24rpx; color: #667eea; padding: 10rpx 28rpx; border-radius: 12rpx; background: rgba(102,126,234,0.1); }
.batch-hint { font-size: 24rpx; color: #8892b0; text-align: center; margin-bottom: 20rpx; }
.batch-actions { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.batch-btn { flex: 1; height: 72rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; font-size: 24rpx; font-weight: 600; }
.batch-btn-save { background: linear-gradient(135deg, #1a1a2e 0%, #2d2d5e 100%); }
.batch-btn-clear { background: #f0f4f8; color: #8892b0; }
.batch-list { margin-bottom: 20rpx; }
.batch-card { display: flex; align-items: center; gap: 16rpx; padding: 16rpx; margin-bottom: 12rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04); }
.batch-thumb { width: 80rpx; height: 80rpx; border-radius: 12rpx; flex-shrink: 0; }
.batch-info { flex: 1; overflow: hidden; }
.batch-size { font-size: 22rpx; color: #8892b0; display: block; margin-bottom: 4rpx; }
.batch-preview { font-size: 20rpx; color: #667eea; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }
.batch-copy { font-size: 22rpx; color: #667eea; padding: 8rpx 16rpx; border-radius: 10rpx; background: rgba(102,126,234,0.1); flex-shrink: 0; }
.files-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 9999; }
.files-modal { position: fixed; top: 15%; left: 40rpx; right: 40rpx; bottom: 15%; background: #fff; border-radius: 24rpx; z-index: 10000; display: flex; flex-direction: column; overflow: hidden; animation: scaleIn 0.25s ease; box-shadow: 0 24rpx 64rpx rgba(0,0,0,0.15); }
.files-hd { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx; border-bottom: 1rpx solid #f0f0f0; }
.files-title { font-size: 30rpx; font-weight: 700; color: #1a1a2e; }
.files-close { font-size: 32rpx; color: #8892b0; padding: 10rpx; }
.files-body { flex: 1; padding: 8rpx 0; }
.files-item { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 32rpx; border-bottom: 1rpx solid #f5f5f5; }
.files-item:active { background: #f8f8f8; }
.files-name { font-size: 28rpx; color: #1a1a2e; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.files-arrow { font-size: 36rpx; color: #c0c0c0; margin-left: 12rpx; }
.files-empty { text-align: center; color: #8892b0; font-size: 26rpx; padding-top: 80rpx; }
