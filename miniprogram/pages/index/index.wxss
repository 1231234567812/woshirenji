/* Skeleton Loading */
@keyframes skeletonPulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
.skeleton-card { border-radius: 24rpx; overflow: hidden; background: #fff; margin-bottom: 32rpx; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04); animation: skeletonPulse 1.5s ease-in-out infinite; }
.skeleton-body { padding: 40rpx 36rpx; }
.skeleton-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; }
.skeleton-line { border-radius: 8rpx; background: #E5E5EA; }
.skeleton-title { width: 200rpx; height: 32rpx; }
.skeleton-date { width: 120rpx; height: 24rpx; }
.skeleton-imgs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-bottom: 18rpx; }
.skeleton-img { aspect-ratio: 1; border-radius: 18rpx; background: #E5E5EA; }
.skeleton-count { width: 80rpx; height: 24rpx; }

.dark .skeleton-card { background: #1C1C1E; box-shadow: none; }
.dark .skeleton-line { background: #2C2C2E; }
