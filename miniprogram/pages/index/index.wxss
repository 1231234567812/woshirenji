page { background: #F5F5F7; }
.box { padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom)); background: #F5F5F7; animation: fadeIn 0.4s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes slideUp { from { opacity: 0; transform: translateY(60rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes scaleIn { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }
@keyframes cardIn { from { opacity: 0; transform: translateY(30rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes pulse { 0%,100% { box-shadow: 0 16rpx 48rpx rgba(0,113,227,0.25); } 50% { box-shadow: 0 16rpx 64rpx rgba(0,113,227,0.35); } }
@keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8rpx); } }
.work-view { animation: scaleIn 0.3s ease; }
.hero { text-align: center; padding: 60rpx 0 40rpx; position: relative; overflow: hidden; }
.hero::before { content: ''; position: absolute; top: -60rpx; left: -80rpx; width: 300rpx; height: 300rpx; border-radius: 50%; background: radial-gradient(circle, rgba(0,113,227,0.08) 0%, transparent 70%); z-index: 0; animation: floatOrb1 6s ease-in-out infinite; }
.hero::after { content: ''; position: absolute; top: -20rpx; right: -60rpx; width: 240rpx; height: 240rpx; border-radius: 50%; background: radial-gradient(circle, rgba(0,113,227,0.06) 0%, transparent 70%); z-index: 0; animation: floatOrb2 7s ease-in-out infinite; }
@keyframes floatOrb1 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(20rpx, 16rpx) scale(1.08); } }
@keyframes floatOrb2 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-16rpx, 20rpx) scale(1.05); } }
.hero-icon-wrap { width: 130rpx; height: 130rpx; border-radius: 36rpx; background: #0071E3; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 28rpx; animation: float 4s ease-in-out infinite; will-change: transform; position: relative; z-index: 1; box-shadow: 0 12rpx 32rpx rgba(0,113,227,0.25); }
.hero-icon { font-size: 60rpx; color: #fff; line-height: 1; }
.hero-title { display: block; font-size: 42rpx; font-weight: 800; color: #1D1D1F; letter-spacing: 3rpx; margin-bottom: 12rpx; position: relative; z-index: 1; }
.hero-sub { display: block; font-size: 26rpx; color: #86868B; letter-spacing: 1rpx; position: relative; z-index: 1; }
.quick-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-bottom: 28rpx; }
.quick-card { background: #fff; border-radius: 28rpx; padding: 36rpx 24rpx; display: flex; flex-direction: column; align-items: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), opacity 0.25s ease, box-shadow 0.25s ease; position: relative; overflow: hidden; animation: cardIn 0.4s ease both; will-change: transform; }
.quick-card:nth-child(1) { animation-delay: 0.05s; }
.quick-card:nth-child(2) { animation-delay: 0.1s; }
.quick-card:nth-child(3) { animation-delay: 0.15s; }
.quick-card:nth-child(4) { animation-delay: 0.2s; }
.quick-card:nth-child(5) { animation-delay: 0.25s; }
.quick-card:nth-child(6) { animation-delay: 0.3s; }
.quick-card:active { box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1); transform: scale(0.97); }
.quick-press { transform: scale(0.95); opacity: 0.85; }
.quick-icon-box { width: 96rpx; height: 96rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 20rpx; position: relative; }
.qi-1 { background: #E8F4FD; }
.qi-2 { background: #FDE8F4; }
.qi-3 { background: #FDF5E8; }
.qi-4 { background: #E8FDE8; }
.qi-5 { background: #E8E8FD; }
.qi-6 { background: #F4FDE8; }
.quick-emoji { font-size: 44rpx; line-height: 1; }
.quick-label { font-size: 26rpx; font-weight: 700; color: #1D1D1F; letter-spacing: 1rpx; }
.browse-bar { display: flex; align-items: center; padding: 30rpx 32rpx; margin-bottom: 28rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); transition: transform 0.25s ease, opacity 0.25s ease; position: relative; overflow: hidden; }
.browse-bar::before { content: ''; position: absolute; left: 0; top: 10rpx; bottom: 10rpx; width: 6rpx; border-radius: 3rpx; background: #0071E3; }
.browse-press { opacity: 0.7; transform: scale(0.98); }
.browse-icon { font-size: 38rpx; margin-right: 16rpx; }
.browse-text { flex: 1; font-size: 28rpx; color: #1D1D1F; font-weight: 600; }
.browse-arrow { font-size: 34rpx; color: #0071E3; font-weight: 300; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; padding: 0 4rpx; position: relative; }
.section-title { font-size: 32rpx; font-weight: 800; color: #1a1a2e; letter-spacing: 1rpx; position: relative; display: inline-block; }
.section-title::after { content: ''; position: absolute; bottom: -8rpx; left: 0; width: 48rpx; height: 6rpx; border-radius: 3rpx; background: linear-gradient(90deg, #667eea 0%, #764ba2 100%); }
.section-count { font-size: 24rpx; color: #667eea; background: rgba(102,126,234,0.1); padding: 4rpx 16rpx; border-radius: 20rpx; font-weight: 600; }
.card { display: flex; border-radius: 28rpx; overflow: hidden; background: linear-gradient(145deg, #ffffff 0%, #fafbff 100%); margin-bottom: 24rpx; box-shadow: 0 8rpx 32rpx rgba(102,126,234,0.08), 0 2rpx 8rpx rgba(0,0,0,0.04); animation: cardIn 0.4s cubic-bezier(0.34,1.56,0.64,1) both; transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s ease; border: 1rpx solid rgba(102,126,234,0.06); will-change: transform; position: relative; }
.card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4rpx; background: linear-gradient(90deg, rgba(102,126,234,0.15), rgba(118,75,162,0.15), rgba(102,126,234,0.15)); opacity: 0; transition: opacity 0.3s ease; }
.card:nth-child(1) { animation-delay: 0s; }
.card:nth-child(2) { animation-delay: 0.06s; }
.card:nth-child(3) { animation-delay: 0.12s; }
.card:nth-child(4) { animation-delay: 0.18s; }
.card:nth-child(5) { animation-delay: 0.24s; }
.card:nth-child(6) { animation-delay: 0.3s; }
.card:active { transform: scale(0.97) translateY(2rpx); box-shadow: 0 4rpx 16rpx rgba(102,126,234,0.12); }
.card:active::before { opacity: 1; }
.card-accent { width: 12rpx; flex-shrink: 0; background: linear-gradient(180deg, #667eea 0%, #764ba2 50%, #667eea 100%); background-size: 100% 200%; animation: accentFlow 3s ease-in-out infinite; }
@keyframes accentFlow { 0%,100% { background-position: 0% 0%; } 50% { background-position: 0% 100%; } }
.card-body { flex: 1; padding: 32rpx; }
.card-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; }
.card-name { font-size: 32rpx; font-weight: 800; color: #1a1a2e; letter-spacing: 2rpx; }
.card-date { font-size: 22rpx; color: #8892b0; font-weight: 500; background: rgba(102,126,234,0.06); padding: 6rpx 16rpx; border-radius: 20rpx; }
.card-imgs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; margin-bottom: 18rpx; }
.card-img { width: 100%; aspect-ratio: 1; border-radius: 18rpx; border: 2rpx solid rgba(102,126,234,0.06); object-fit: cover; transition: transform 0.2s ease; }
.card-img:active { transform: scale(0.95); }
.card-ft { display: flex; justify-content: space-between; align-items: center; padding-top: 16rpx; border-top: 1rpx solid rgba(102,126,234,0.06); }
.card-num { font-size: 24rpx; color: #667eea; font-weight: 700; display: flex; align-items: center; gap: 8rpx; }
.card-num::before { content: ''; width: 8rpx; height: 8rpx; border-radius: 50%; background: linear-gradient(135deg, #667eea, #764ba2); }
.card-del { font-size: 24rpx; color: #e74c3c; padding: 12rpx 28rpx; border-radius: 16rpx; background: linear-gradient(135deg, #fff5f5, #fee2e2); font-weight: 700; border: 1rpx solid rgba(231,76,60,0.12); transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), background 0.25s ease; }
.card-del:active { transform: scale(0.92); background: linear-gradient(135deg, #fee2e2, #fecaca); }
.empty-state { text-align: center; padding: 100rpx 0; position: relative; }
.empty-icon { display: block; font-size: 110rpx; margin-bottom: 28rpx; animation: float 3s ease-in-out infinite; position: relative; z-index: 1; will-change: transform; }
.empty-icon::before { content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 200rpx; height: 200rpx; border-radius: 50%; background: radial-gradient(circle, rgba(102,126,234,0.1) 0%, rgba(102,126,234,0.04) 40%, transparent 70%); z-index: -1; animation: emptyPulse 3s ease-in-out infinite; }
@keyframes emptyPulse { 0%,100% { transform: translate(-50%,-50%) scale(1); opacity: 0.8; } 50% { transform: translate(-50%,-50%) scale(1.15); opacity: 1; } }
.empty-text { display: block; font-size: 32rpx; font-weight: 700; color: #1a1a2e; margin-bottom: 12rpx; letter-spacing: 1rpx; }
.empty-hint { display: block; font-size: 26rpx; color: #8892b0; line-height: 1.6; }
.fab { position: fixed; bottom: calc(180rpx + env(safe-area-inset-bottom)); right: 40rpx; width: 120rpx; height: 120rpx; border-radius: 50%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); box-shadow: 0 12rpx 40rpx rgba(102,126,234,0.5); display: flex; align-items: center; justify-content: center; z-index: 999; animation: pulse 3s ease-in-out infinite; border: 4rpx solid rgba(255,255,255,0.3); will-change: box-shadow; }
.fab-press { transform: scale(0.9); opacity: 0.8; }
.fab-txt { font-size: 56rpx; color: #fff; line-height: 1; font-weight: 300; }
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 0 32rpx; }
.back { width: 68rpx; height: 68rpx; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; font-size: 30rpx; color: #667eea; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06); border: 1rpx solid rgba(102,126,234,0.1); transition: transform 0.2s ease, opacity 0.2s ease; }
.back-press { opacity: 0.6; transform: scale(0.92); }
.topbar-title { font-size: 34rpx; font-weight: 800; color: #1a1a2e; letter-spacing: 2rpx; }
.topbar-folder { width: 68rpx; height: 68rpx; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; font-size: 30rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06); border: 1rpx solid rgba(102,126,234,0.1); transition: transform 0.2s ease, opacity 0.2s ease; }
.btn { height: 96rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; font-size: 30rpx; font-weight: 700; margin-bottom: 24rpx; box-shadow: 0 8rpx 28rpx rgba(102,126,234,0.35); transition: transform 0.25s ease, opacity 0.25s ease, box-shadow 0.25s ease; letter-spacing: 2rpx; }
.btn-press { transform: scale(0.97); opacity: 0.85; box-shadow: 0 4rpx 16rpx rgba(102,126,234,0.4); }
.btn-cvt { background: linear-gradient(135deg, #1a1a2e 0%, #2d2d5e 100%); box-shadow: 0 8rpx 28rpx rgba(26,26,46,0.3); }
.btn-loading { opacity: 0.6; pointer-events: none; background: linear-gradient(90deg, #667eea, #764ba2, #667eea); background-size: 200% 100%; animation: shimmer 1.5s infinite; }
.quality-bar { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 30rpx; margin-bottom: 20rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04); border: 1rpx solid rgba(0,0,0,0.03); }
.quality-label { font-size: 26rpx; color: #8892b0; font-weight: 600; }
.quality-opts { display: flex; gap: 14rpx; }
.quality-opt { font-size: 24rpx; color: #8892b0; padding: 12rpx 30rpx; border-radius: 14rpx; background: #f0f4f8; transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), background 0.25s ease, color 0.25s ease; font-weight: 600; }
.quality-opt.active { color: #fff; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); font-weight: 700; box-shadow: 0 4rpx 16rpx rgba(102,126,234,0.3); }
.progress-wrap { margin-bottom: 20rpx; padding: 28rpx 30rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04); border: 1rpx solid rgba(0,0,0,0.03); }
.progress-bar { height: 14rpx; border-radius: 7rpx; background: #e8ecf1; overflow: hidden; margin-bottom: 14rpx; }
.progress-fill { height: 100%; border-radius: 7rpx; background: linear-gradient(90deg, #667eea 0%, #764ba2 100%); transition: width 0.3s ease; position: relative; }
.progress-fill::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent); animation: shimmer 1.5s infinite; background-size: 200% 100%; }
.progress-text { font-size: 22rpx; color: #8892b0; text-align: center; display: block; font-weight: 600; }
.preview { position: relative; height: 400rpx; border-radius: 24rpx; overflow: hidden; margin-bottom: 24rpx; background: #e8ecf1; box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.08); }
.preview-img { width: 100%; height: 100%; }
.preview-tip { position: absolute; bottom: 16rpx; right: 16rpx; font-size: 20rpx; color: #fff; padding: 10rpx 24rpx; border-radius: 12rpx; background: rgba(0,0,0,0.5); backdrop-filter: blur(10rpx); font-weight: 500; }
.code-box { border-radius: 24rpx; overflow: hidden; background: linear-gradient(145deg, #1a1a2e 0%, #0d0d1a 100%); margin-bottom: 24rpx; box-shadow: 0 8rpx 32rpx rgba(26,26,46,0.3); }
.code-hd { display: flex; justify-content: space-between; align-items: center; padding: 22rpx 30rpx; border-bottom: 1rpx solid rgba(255,255,255,0.08); }
.code-label { font-size: 24rpx; color: #a8dadc; font-weight: 600; }
.code-actions { display: flex; gap: 14rpx; }
.code-copy { font-size: 24rpx; color: #f1faee; padding: 10rpx 24rpx; border-radius: 12rpx; background: rgba(45,45,94,0.8); font-weight: 600; border: 1rpx solid rgba(255,255,255,0.08); transition: background 0.2s ease; }
.code-copy:active { background: rgba(102,126,234,0.4); }
.code-body { height: 400rpx; padding: 26rpx; }
.code-text { font-size: 22rpx; color: #a8dadc; word-break: break-all; line-height: 1.7; font-family: 'Menlo', 'Consolas', monospace; }
.file-pick { text-align: right; margin-bottom: 16rpx; }
.file-pick text { font-size: 26rpx; color: #667eea; padding: 14rpx 30rpx; border-radius: 14rpx; background: #fff; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04); font-weight: 600; border: 1rpx solid rgba(102,126,234,0.1); transition: transform 0.2s ease, opacity 0.2s ease; }
.file-pick:active text { opacity: 0.7; transform: scale(0.97); }
.text-in { width: 100%; height: 320rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; font-size: 28rpx; color: #1a1a2e; margin-bottom: 24rpx; box-sizing: border-box; box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04); border: 2rpx solid rgba(0,0,0,0.04); line-height: 1.6; transition: border-color 0.3s ease, box-shadow 0.3s ease; }
.text-in:focus { border-color: rgba(102,126,234,0.35); box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.04), 0 0 0 4rpx rgba(102,126,234,0.08); }
.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 1000; backdrop-filter: blur(4rpx); }
.menu { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-radius: 36rpx 36rpx 0 0; padding: 20rpx 32rpx calc(60rpx + env(safe-area-inset-bottom)); z-index: 1001; animation: slideUp 0.35s cubic-bezier(0.34,1.56,0.64,1); }
.menu-hd { text-align: center; padding: 20rpx 0 28rpx; }
.menu-hd::before { content: ''; display: block; width: 64rpx; height: 8rpx; border-radius: 4rpx; background: #e0e0e0; margin: 0 auto 20rpx; }
.menu-title { font-size: 32rpx; font-weight: 800; color: #1a1a2e; letter-spacing: 2rpx; }
.menu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-bottom: 28rpx; }
.menu-card { display: flex; flex-direction: column; align-items: center; padding: 32rpx 16rpx; border-radius: 24rpx; background: #f5f7fb; transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), opacity 0.25s ease; border: 1rpx solid rgba(0,0,0,0.03); }
.menu-card-press { transform: scale(0.95); opacity: 0.8; }
.menu-card-icon { width: 80rpx; height: 80rpx; border-radius: 22rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; margin-bottom: 14rpx; position: relative; }
.menu-card-icon::after { content: ''; position: absolute; inset: -4rpx; border-radius: 26rpx; background: inherit; opacity: 0.3; filter: blur(6rpx); z-index: -1; }
.mc-1 { background: linear-gradient(135deg, #a8edea, #fed6e3); }
.mc-2 { background: linear-gradient(135deg, #fbc2eb, #a6c1ee); }
.mc-3 { background: linear-gradient(135deg, #fddb92, #d1fdff); }
.mc-4 { background: linear-gradient(135deg, #c1dfc4, #deecdd); }
.mc-5 { background: linear-gradient(135deg, #d4fc79, #96e6a1); }
.mc-6 { background: linear-gradient(135deg, #a1c4fd, #c2e9fb); }
.menu-card-label { font-size: 26rpx; font-weight: 700; color: #1a1a2e; letter-spacing: 1rpx; }
.menu-cancel { margin-top: 8rpx; text-align: center; font-size: 28rpx; color: #8892b0; padding: 24rpx 0; font-weight: 600; }
.history { margin-top: 28rpx; padding: 28rpx; border-radius: 28rpx; background: linear-gradient(145deg, rgba(255,255,255,0.95) 0%, rgba(240,244,248,0.95) 100%); box-shadow: 0 8rpx 32rpx rgba(102,126,234,0.06); border: 1rpx solid rgba(102,126,234,0.06); backdrop-filter: blur(10rpx); }
.h-title { font-size: 32rpx; color: #1a1a2e; font-weight: 800; margin-bottom: 24rpx; display: flex; align-items: center; gap: 12rpx; letter-spacing: 2rpx; }
.h-title::before { content: ''; width: 8rpx; height: 32rpx; border-radius: 4rpx; background: linear-gradient(180deg, #667eea 0%, #764ba2 100%); }
.h-list { white-space: nowrap; padding-bottom: 8rpx; }
.h-item { display: inline-block; margin-right: 20rpx; text-align: center; vertical-align: top; transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1); }
.h-item:active { transform: scale(0.95); }
.h-img { width: 160rpx; height: 160rpx; border-radius: 22rpx; display: block; border: 2rpx solid rgba(102,126,234,0.08); box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); transition: transform 0.2s ease, box-shadow 0.2s ease; }
.h-img:active { transform: scale(0.95); box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1); }
.h-text-card { width: 160rpx; height: 160rpx; border-radius: 22rpx; background: linear-gradient(145deg, #e8edff 0%, #f0e8ff 100%); display: flex; align-items: center; justify-content: center; padding: 20rpx; box-sizing: border-box; border: 2rpx solid rgba(102,126,234,0.1); box-shadow: 0 4rpx 16rpx rgba(102,126,234,0.08); position: relative; overflow: hidden; }
.h-text-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4rpx; background: linear-gradient(90deg, #667eea, #764ba2); }
.h-text-preview { font-size: 22rpx; color: #667eea; word-break: break-all; line-height: 1.5; font-weight: 600; }
.h-size { font-size: 20rpx; color: #8892b0; margin-top: 12rpx; display: block; font-weight: 600; background: rgba(102,126,234,0.06); padding: 4rpx 12rpx; border-radius: 12rpx; }
.h-item-main { display: block; }
.h-item-ft { display: flex; align-items: center; justify-content: center; gap: 10rpx; margin-top: 12rpx; }
.h-copy { font-size: 20rpx; color: #667eea; padding: 8rpx 18rpx; border-radius: 12rpx; background: rgba(102,126,234,0.12); font-weight: 700; transition: transform 0.2s ease, background 0.2s ease; border: 1rpx solid rgba(102,126,234,0.15); }
.h-copy:active { background: rgba(102,126,234,0.2); transform: scale(0.95); }
.one-click-copy { text-align: center; padding: 20rpx 0; }
.one-click-text { font-size: 26rpx; color: #667eea; padding: 14rpx 32rpx; border-radius: 16rpx; background: rgba(102,126,234,0.1); font-weight: 700; letter-spacing: 1rpx; border: 1rpx solid rgba(102,126,234,0.15); transition: transform 0.2s ease, background 0.2s ease; }
.one-click-text:active { background: rgba(102,126,234,0.2); transform: scale(0.97); }
.batch-hint { font-size: 26rpx; color: #8892b0; text-align: center; margin-bottom: 20rpx; font-weight: 500; }
.batch-actions { display: flex; gap: 14rpx; margin-bottom: 20rpx; }
.batch-btn { flex: 1; height: 76rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; font-size: 24rpx; font-weight: 700; box-shadow: 0 4rpx 16rpx rgba(102,126,234,0.25); transition: transform 0.2s ease; }
.batch-btn:active { transform: scale(0.97); }
.batch-btn-save { background: linear-gradient(135deg, #1a1a2e 0%, #2d2d5e 100%); box-shadow: 0 4rpx 16rpx rgba(26,26,46,0.25); }
