.dark .btn-cvt { background: linear-gradient(135deg, #0d0d1a 0%, #1a1a3e 100%); box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.3); }
.dark .btn-loading { background: linear-gradient(90deg, #4a5a8a, #5a3a7a, #4a5a8a); background-size: 200% 100%; }
.dark .preview { background: #161625; box-shadow: none; }
.dark .text-in { background: #161625; color: #e0e0e0; box-shadow: none; border: 2rpx solid rgba(255,255,255,0.06); }
