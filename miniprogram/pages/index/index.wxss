page { background: #f1faee; }
.box { padding: 24rpx 24rpx calc(180rpx + env(safe-area-inset-bottom)); background: #f1faee; animation: fadeIn 0.3s ease; }

@keyframes fadeIn { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes slideUp { from { opacity: 0; transform: translateY(60rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes scaleIn { from { opacity: 0; transform: scale(0.92); } to { opacity: 1; transform: scale(1); } }

.work-view { animation: scaleIn 0.3s ease; }

/* 顶栏 */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10rpx 0 24rpx;
}
.back {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  background: #e8edff; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: #457b9d;
}
.back:active { opacity: 0.6; }
.topbar-title { font-size: 30rpx; font-weight: 600; color: #1d3557; }
.topbar-folder {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  background: #e8edff; display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
}
.topbar-folder:active { opacity: 0.6; }

/* 按钮 */
.btn {
  height: 88rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 16rpx; background: #457b9d; color: #fff;
  font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx;
  transition: all 0.2s ease;
}
.btn-press { transform: scale(0.95); opacity: 0.85; }
.btn-cvt { background: #1d3557; }

/* 预览 */
.preview {
  position: relative; height: 400rpx; border-radius: 16rpx;
  overflow: hidden; margin-bottom: 24rpx; background: #e8f0eb;
}
.preview-img { width: 100%; height: 100%; }
.preview-tip {
  position: absolute; bottom: 16rpx; right: 16rpx;
  font-size: 20rpx; color: #fff; padding: 6rpx 16rpx;
  border-radius: 8rpx; background: rgba(0,0,0,0.4);
}

/* 代码框 */
.code-box { border-radius: 16rpx; overflow: hidden; background: #1d3557; margin-bottom: 24rpx; }
.code-hd {
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 24rpx; border-bottom: 1rpx solid rgba(255,255,255,0.1);
}
.code-label { font-size: 24rpx; color: #a8dadc; }
.code-actions { display: flex; gap: 12rpx; }
.code-copy {
  font-size: 24rpx; color: #f1faee; padding: 8rpx 20rpx;
  border-radius: 8rpx; background: #457b9d;
}

/* 加载态按钮 */
.btn-loading {
  opacity: 0.6;
  pointer-events: none;
}
.code-body { height: 400rpx; padding: 24rpx; }
.code-text { font-size: 22rpx; color: #a8dadc; word-break: break-all; line-height: 1.6; }

/* 选择文件 */
.file-pick {
  text-align: right; margin-bottom: 12rpx;
}
.file-pick text {
  font-size: 26rpx; color: #457b9d; padding: 10rpx 24rpx;
  border-radius: 10rpx; background: #e8edff;
}
.file-pick:active text { opacity: 0.7; }

/* 文字输入 */
.text-in {
  width: 100%; height: 300rpx; padding: 24rpx; border-radius: 16rpx;
  background: #fff; font-size: 28rpx; color: #1d3557;
  margin-bottom: 24rpx; box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

/* 空 */
.tip { text-align: center; padding-top: 250rpx; }
.tip-icon { display: block; font-size: 100rpx; color: #a8dadc; line-height: 1; }
.tip-text { font-size: 28rpx; color: #999; margin-top: 20rpx; display: block; }

.file-browse-bar {
  text-align: center; padding: 26rpx; margin-bottom: 16rpx;
  border-radius: 16rpx; background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  font-size: 28rpx; color: #457b9d;
}
.file-browse-bar:active { opacity: 0.7; }

/* 项目卡片 */
.card {
  padding: 20rpx; margin-bottom: 16rpx; border-radius: 16rpx;
  background: #fff; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  animation: cardIn 0.35s ease both;
}
@keyframes cardIn { from { opacity: 0; transform: translateY(30rpx); } to { opacity: 1; transform: translateY(0); } }

/* 卡片交错动画 */
.card:nth-child(1) { animation-delay: 0s; }
.card:nth-child(2) { animation-delay: 0.05s; }
.card:nth-child(3) { animation-delay: 0.1s; }
.card:nth-child(4) { animation-delay: 0.15s; }
.card:nth-child(5) { animation-delay: 0.2s; }
.card-hd { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.card-name { font-size: 28rpx; font-weight: 600; color: #1d3557; }
.card-date { font-size: 22rpx; color: #999; }
.card-imgs { display: flex; gap: 8rpx; margin-bottom: 12rpx; }
.card-img { width: 130rpx; height: 130rpx; border-radius: 10rpx; }
.card-ft { display: flex; justify-content: space-between; align-items: center; }
.card-num { font-size: 24rpx; color: #457b9d; }
.card-del { font-size: 28rpx; color: #e74c3c; padding: 10rpx 24rpx; border-radius: 10rpx; background: #fde8e8; }

/* 浮动按钮 */
.fab {
  position: fixed; bottom: calc(180rpx + env(safe-area-inset-bottom)); right: 50rpx;
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: #457b9d;
  box-shadow: 0 8rpx 24rpx rgba(69,123,157,0.4);
  display: flex; align-items: center; justify-content: center; z-index: 999;
}
.fab-press { transform: scale(0.9); opacity: 0.8; }
.fab-txt { font-size: 50rpx; color: #fff; line-height: 1; }

/* 历史 */
.history { margin-top: 10rpx; }
.h-title { font-size: 26rpx; color: #1d3557; font-weight: 600; margin-bottom: 16rpx; display: block; }
.h-list { white-space: nowrap; }
.h-item { display: inline-block; margin-right: 16rpx; text-align: center; vertical-align: top; }
.h-img { width: 140rpx; height: 140rpx; border-radius: 12rpx; display: block; }
.h-text-card {
  width: 140rpx; height: 140rpx; border-radius: 12rpx;
  background: #e8edff; display: flex; align-items: center; justify-content: center;
  padding: 16rpx; box-sizing: border-box;
}
.h-text-preview { font-size: 22rpx; color: #457b9d; word-break: break-all; line-height: 1.4; }
.h-size { font-size: 20rpx; color: #999; margin-top: 6rpx; display: block; }

/* 菜单 */
.mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.3); z-index: 1000; }
.menu {
  position: fixed; bottom: 0; left: 0; right: 0; background: #fff;
  border-radius: 32rpx 32rpx 0 0; padding: 30rpx 30rpx 60rpx; z-index: 1001;
  animation: slideUp 0.3s ease;
}
.menu-group { font-size: 24rpx; color: #999; padding: 30rpx 0 10rpx; }
.menu-item { padding: 26rpx 0; border-bottom: 1rpx solid #f0f0f0; font-size: 32rpx; color: #1d3557; }
.menu-cancel { margin-top: 20rpx; text-align: center; font-size: 28rpx; color: #999; padding: 24rpx 0; }

/* 文件浏览弹窗 */
.files-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4); z-index: 9999; }
.files-modal {
  position: fixed; top: 15%; left: 40rpx; right: 40rpx; bottom: 15%;
  background: #fff; border-radius: 20rpx; z-index: 10000;
  display: flex; flex-direction: column; overflow: hidden;
  animation: scaleIn 0.25s ease;
}
.files-hd {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 30rpx; border-bottom: 1rpx solid #eee;
}
.files-title { font-size: 30rpx; font-weight: 600; color: #1d3557; }
.files-close { font-size: 32rpx; color: #999; padding: 10rpx; }
.files-body { flex: 1; padding: 16rpx 0; }
.files-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 30rpx; border-bottom: 1rpx solid #f5f5f5;
}
.files-item:active { background: #f8f8f8; }
.files-name { font-size: 28rpx; color: #1d3557; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.files-arrow { font-size: 36rpx; color: #ccc; margin-left: 12rpx; }
.files-empty { text-align: center; color: #999; font-size: 26rpx; padding-top: 80rpx; }

/* 深色模式 */
.box.dark { background: #1a1a2e; }
.dark .card { background: #16213e; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.2); }
.dark .card-name { color: #e0e0e0; }
.dark .card-date { color: #888; }
.dark .card-num { color: #a8dadc; }
.dark .card-del { background: #3d1a1a; }
.dark .text-in { background: #1a1a2e; color: #e0e0e0; }
.dark .code-box { background: #0d1b2a; }
.dark .code-text { color: #a8dadc; }
.dark .code-hd { border-bottom-color: rgba(255,255,255,0.06); }
.dark .topbar-title { color: #e0e0e0; }
.dark .back { background: #1a1a3e; color: #a8dadc; }
.dark .topbar-folder { background: #1a1a3e; }
.dark .preview { background: #1a1a2e; }
.dark .h-title { color: #e0e0e0; }
.dark .h-text-card { background: #1a1a3e; }
.dark .h-text-preview { color: #a8dadc; }
.dark .h-size { color: #888; }
.dark .file-browse-bar { background: #16213e; color: #a8dadc; }
.dark .menu { background: #16213e; }
.dark .menu-item { color: #e0e0e0; border-bottom-color: #2a2a4a; }
.dark .menu-group { color: #888; }
.dark .menu-cancel { color: #777; }
.dark .files-modal { background: #16213e; }
.dark .files-title { color: #e0e0e0; }
.dark .files-item { border-bottom-color: #2a2a4a; }
.dark .files-name { color: #e0e0e0; }
.dark .files-hd { border-bottom-color: #2a2a4a; }
.dark .files-item:active { background: #1a1a2e; }
.dark .btn { background: #2a4a6d; }
.dark .btn-cvt { background: #0d1b2a; }
.dark .tip-icon { color: #555; }
.dark .tip-text { color: #888; }
.dark .file-pick text { background: #1a1a3e; color: #a8dadc; }
.dark .code-label { color: #6d8a9c; }
.dark .code-copy { background: #2a4a6d; }
.dark .files-close { color: #777; }
.dark .files-arrow { color: #666; }
