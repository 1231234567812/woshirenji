<view class="box {{darkMode ? 'dark' : ''}}">
  <!-- ========== 项目列表 ========== -->
  <block wx:if="{{view === 'list'}}">
    <view wx:if="{{projects.length === 0}}" class="tip">
      <text class="tip-icon">+</text>
      <text class="tip-text">点击右下角创建项目</text>
    </view>
    <view class="file-browse-bar" bindtap="browseFiles">
      <text>浏览保存的文件</text>
    </view>
    <view wx:for="{{projects}}" wx:key="id" class="card" bindtap="openProject" data-id="{{item.id}}">
      <view class="card-hd">
        <text class="card-name">{{item.name}}</text>
        <text class="card-date">{{item.date}}</text>
      </view>
      <view class="card-imgs" wx:if="{{item.items.length > 0}}">
        <image wx:for="{{item.items}}" wx:for-item="img" wx:key="id" class="card-img" src="{{img.path}}" mode="aspectFill" wx:if="{{img.type === 'image' && index < 4}}" />
      </view>
      <view class="card-ft">
        <text class="card-num">{{item.items.length}} 项</text>
        <text class="card-del" catchtap="delProject" data-id="{{item.id}}">删除</text>
      </view>
    </view>
    <view class="fab" hover-class="fab-press" bindtap="createProject">
      <text class="fab-txt">+</text>
    </view>
  </block>

  <!-- ========== 工作台视图 ========== -->
  <block wx:if="{{view === 'work'}}">
  <view class="work-view">
    <view class="topbar">
      <view class="back" bindtap="goBack"><text>←</text></view>
      <text class="topbar-title">{{curName}}</text>
      <view class="topbar-folder" bindtap="browseFiles"><text>📁</text></view>
    </view>

    <block wx:if="{{mode === 'img2code'}}">
      <view class="btn" hover-class="btn-press" wx:if="{{!imagePath}}" bindtap="chooseImage">选择图片</view>
      <view class="preview" wx:if="{{imagePath}}" bindtap="previewImg">
        <image class="preview-img" src="{{imagePath}}" mode="aspectFit" />
        <text class="preview-tip">点击预览大图</text>
      </view>
      <view class="btn btn-cvt btn-loading" wx:if="{{imagePath && converting}}">转换中...</view>
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{imagePath && !converting}}" bindtap="convertImage">转为代码</view>

      <view class="code-box" wx:if="{{codeShow}}">
        <view class="code-hd">
          <text class="code-label">Base64（{{size}}）</text>
          <view class="code-actions">
            <text class="code-copy" bindtap="shareCodeFile">转发</text>
            <text class="code-copy" bindtap="saveCodeFile">保存</text>
            <text class="code-copy" bindtap="copyCode">复制</text>
          </view>
        </view>
        <scroll-view class="code-body" scroll-y><text class="code-text" user-select>{{codeShow}}</text></scroll-view>
      </view>
    </block>

    <block wx:if="{{mode === 'text2code'}}">
      <view class="file-pick" bindtap="pickFileForMode" data-mode="text2code"><text>选择文件</text></view>
      <textarea class="text-in" placeholder="输入要转换的文字..." value="{{textContent}}" bindinput="onTextInput" />
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{textContent}}" bindtap="convertText">转为代码</view>
      <view class="code-box" wx:if="{{textResult}}">
        <view class="code-hd"><text class="code-label">Base64</text><text class="code-copy" bindtap="copyTextCode">复制</text></view>
        <scroll-view class="code-body" scroll-y><text class="code-text" user-select>{{textResult}}</text></scroll-view>
      </view>
    </block>

    <block wx:if="{{mode === 'code2text'}}">
      <view class="file-pick" bindtap="pickFileForMode" data-mode="code2text"><text>选择文件</text></view>
      <textarea class="text-in" placeholder="粘贴 Base64 代码..." value="{{decodeInput}}" bindinput="onDecodeInput" />
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{decodeInput}}" bindtap="decodeToText">转为文字</view>
      <view class="code-box" wx:if="{{decodeResult}}">
        <view class="code-hd"><text class="code-label">解码结果</text><text class="code-copy" bindtap="copyDecode">复制</text></view>
        <scroll-view class="code-body" scroll-y><text class="code-text" user-select>{{decodeResult}}</text></scroll-view>
      </view>
    </block>

    <block wx:if="{{mode === 'code2img'}}">
      <view class="file-pick" bindtap="pickFileForMode" data-mode="code2img"><text>选择文件</text></view>
      <textarea class="text-in" placeholder="粘贴图片 Base64 代码..." value="{{decodeInput}}" bindinput="onDecodeInput" />
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{decodeInput}}" bindtap="decodeToImage">转为图片</view>
      <view class="preview" wx:if="{{decodeImagePath}}" bindtap="previewDecodeImg">
        <image class="preview-img" src="{{decodeImagePath}}" mode="aspectFit" />
        <text class="preview-tip">点击预览大图</text>
      </view>
    </block>

    <view class="fab" hover-class="fab-press" bindtap="showMenu">
      <text class="fab-txt">+</text>
    </view>
    <view class="mask" wx:if="{{menuShow}}" bindtap="hideMenu"></view>
    <view class="menu" wx:if="{{menuShow}}">
      <view class="menu-group">图片</view>
      <view class="menu-item" bindtap="startImg2Code">图片转代码</view>
      <view class="menu-item" bindtap="startCode2Img">代码转图片</view>
      <view class="menu-group">文字</view>
      <view class="menu-item" bindtap="startText2Code">文字转代码</view>
      <view class="menu-item" bindtap="startCode2Text">代码转文字</view>
      <view class="menu-cancel" bindtap="hideMenu">取消</view>
    </view>

    <view wx:if="{{images.length > 0}}" class="history">
      <text class="h-title">历史记录</text>
      <scroll-view class="h-list" scroll-x>
        <view wx:for="{{images}}" wx:key="id" class="h-item" wx:if="{{index < 20}}">
          <image wx:if="{{item.type === 'image'}}" class="h-img" src="{{item.path}}" mode="aspectFill" bindtap="loadHistory" data-index="{{index}}" />
          <view wx:else class="h-text-card" bindtap="loadHistory" data-index="{{index}}">
            <text class="h-text-preview">{{item.preview}}</text>
          </view>
          <text class="h-size">{{item.size || '未转'}}</text>
        </view>
      </scroll-view>
    </view>
  </view>
  </block>

  <!-- 文件浏览弹窗 -->
  <view class="files-mask" wx:if="{{filesShow}}" bindtap="closeFiles"></view>
  <view class="files-modal" wx:if="{{filesShow}}">
    <view class="files-hd"><text class="files-title">保存的文件</text><text class="files-close" bindtap="closeFiles">✕</text></view>
    <scroll-view class="files-body" scroll-y>
      <view wx:for="{{filesList}}" wx:key="name" class="files-item" bindtap="openFile" data-index="{{index}}">
        <text class="files-name">{{item.name}}</text>
        <text class="files-arrow">›</text>
      </view>
      <view wx:if="{{filesList.length === 0}}" class="files-empty">暂无文件</view>
    </scroll-view>
  </view>
</view>
