<view class="box {{darkMode ? 'dark' : ''}}">
  <!-- ========== 项目列表 ========== -->
  <block wx:if="{{view === 'list'}}">

    <!-- Hero 区域 -->
    <view class="hero">
      <text class="hero-title">Base64 工具箱</text>
      <text class="hero-sub">图片 / 文字 / 二维码</text>
    </view>

    <!-- 功能入口 -->
    <view class="func-list">
      <view class="func-item" hover-class="func-press" bindtap="quickAction" data-mode="img2code">
        <view class="func-icon"><text>图</text></view>
        <text class="func-label">图片转代码</text>
      </view>
      <view class="func-item" hover-class="func-press" bindtap="quickAction" data-mode="code2img">
        <view class="func-icon"><text>码</text></view>
        <text class="func-label">代码转图片</text>
      </view>
      <view class="func-item" hover-class="func-press" bindtap="quickAction" data-mode="text2code">
        <view class="func-icon"><text>文</text></view>
        <text class="func-label">文字转代码</text>
      </view>
      <view class="func-item" hover-class="func-press" bindtap="quickAction" data-mode="qrcode">
        <view class="func-icon"><text>码</text></view>
        <text class="func-label">生成二维码</text>
      </view>
    </view>

    <!-- 骨架屏加载 -->
    <block wx:if="{{loading}}">
      <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skeleton-body">
          <view class="skeleton-row">
            <view class="skeleton-line skeleton-title"></view>
            <view class="skeleton-line skeleton-date"></view>
          </view>
          <view class="skeleton-imgs">
            <view class="skeleton-img"></view>
            <view class="skeleton-img"></view>
            <view class="skeleton-img"></view>
            <view class="skeleton-img"></view>
            <view class="skeleton-img"></view>
            <view class="skeleton-img"></view>
          </view>
          <view class="skeleton-row">
            <view class="skeleton-line skeleton-count"></view>
          </view>
        </view>
      </view>
    </block>

    <!-- 项目列表 -->
    <block wx:if="{{!loading && projects.length > 0}}">
      <view class="section-header">
        <text class="section-title">我的项目</text>
        <text class="section-count">{{projects.length}} 个</text>
      </view>
      <view wx:for="{{projects}}" wx:key="id" class="card" bindtap="openProject" data-id="{{item.id}}">
        <view class="card-hd">
          <text class="card-name">{{item.name}}</text>
          <text class="card-date">{{item.date}}</text>
        </view>
        <scroll-view class="card-imgs" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{item.items.length > 0}}">
          <image wx:for="{{item.items}}" wx:for-item="img" wx:key="id" class="card-img" src="{{img.path}}" mode="aspectFill" lazy-load wx:if="{{img.type === 'image' && index < 8}}" />
        </scroll-view>
        <view class="card-ft">
          <text class="card-num">{{item.items.length}} 项</text>
          <text class="card-del" catchtap="delProject" data-id="{{item.id}}">删除</text>
        </view>
      </view>
    </block>

    <!-- 空状态 -->
    <view wx:if="{{!loading && projects.length === 0}}" class="empty-state">
      <view class="empty-icon-wrap"><text class="empty-icon-text">空</text></view>
      <text class="empty-text">还没有项目</text>
      <text class="empty-hint">点击上方功能开始使用</text>
    </view>

    <view class="create-btn" hover-class="create-press" bindtap="createProject">
      <text>新建项目</text>
    </view>
  </block>

  <!-- ========== 工作台视图 ========== -->
  <block wx:if="{{view === 'work'}}">
  <view class="work-view">
    <view class="topbar">
      <view class="back" hover-class="back-press" bindtap="goBack"><text>←</text></view>
      <text class="topbar-title">{{curName}}</text>
      <view class="topbar-folder" hover-class="back-press" bindtap="browseFiles"><text class="folder-txt">件</text></view>
    </view>

    <block wx:if="{{mode === 'img2code'}}">
      <view class="btn" hover-class="btn-press" wx:if="{{!imagePath}}" bindtap="chooseImage">选择图片</view>
      <view class="preview" wx:if="{{imagePath}}" bindtap="previewImg">
        <image class="preview-img" src="{{imagePath}}" mode="aspectFit" />
        <text class="preview-tip">点击预览大图</text>
      </view>

      <view class="quality-bar" wx:if="{{imagePath && !converting}}">
        <text class="quality-label">压缩质量</text>
        <view class="quality-opts">
          <text class="quality-opt {{compressQuality === 40 ? 'active' : ''}}" bindtap="setQuality" data-q="40">低</text>
          <text class="quality-opt {{compressQuality === 60 ? 'active' : ''}}" bindtap="setQuality" data-q="60">中</text>
          <text class="quality-opt {{compressQuality === 80 ? 'active' : ''}}" bindtap="setQuality" data-q="80">高</text>
        </view>
      </view>

      <view class="progress-wrap" wx:if="{{converting}}">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{convertProgress}}%"></view>
        </view>
        <text class="progress-text">{{convertStage}}</text>
      </view>

      <view class="btn btn-loading" wx:if="{{imagePath && converting}}">转换中...</view>
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{imagePath && !converting}}" bindtap="convertImage">转为代码</view>
      <view class="btn" hover-class="btn-press" wx:if="{{imagePath && !converting}}" bindtap="chooseImage">重新选择</view>

      <view class="code-box" wx:if="{{codeShow}}">
        <view class="code-hd">
          <text class="code-label">Base64（{{size}}）</text>
          <view class="code-actions">
            <text class="code-copy" bindtap="shareCodeFile">转发</text>
            <text class="code-copy" bindtap="saveCodeFile">保存</text>
          </view>
        </view>
        <scroll-view class="code-body" scroll-y enhanced show-scrollbar="{{false}}"><text class="code-text" user-select>{{codeShow}}</text></scroll-view>
        <view class="one-click-copy" hover-class="btn-press" bindtap="copyCode">
          <text class="one-click-text">一键复制完整代码</text>
        </view>
      </view>
    </block>

    <block wx:if="{{mode === 'text2code'}}">
      <view class="file-pick" bindtap="pickFileForMode" data-mode="text2code"><text>选择文件</text></view>
      <textarea class="text-in" placeholder="输入要转换的文字..." value="{{textContent}}" bindinput="onTextInput" />
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{textContent}}" bindtap="convertText">转为代码</view>
      <view class="code-box" wx:if="{{textResult}}">
        <view class="code-hd"><text class="code-label">Base64</text><text class="code-copy" bindtap="copyTextCode">复制</text></view>
        <scroll-view class="code-body" scroll-y enhanced show-scrollbar="{{false}}"><text class="code-text" user-select>{{textResult}}</text></scroll-view>
      </view>
    </block>

    <block wx:if="{{mode === 'code2text'}}">
      <view class="file-pick" bindtap="pickFileForMode" data-mode="code2text"><text>选择文件</text></view>
      <textarea class="text-in" placeholder="粘贴 Base64 代码..." value="{{decodeInput}}" bindinput="onDecodeInput" />
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{decodeInput}}" bindtap="decodeToText">转为文字</view>
      <view class="code-box" wx:if="{{decodeResult}}">
        <view class="code-hd"><text class="code-label">解码结果</text><text class="code-copy" bindtap="copyDecode">复制</text></view>
        <scroll-view class="code-body" scroll-y enhanced show-scrollbar="{{false}}"><text class="code-text" user-select>{{decodeResult}}</text></scroll-view>
      </view>
    </block>

    <block wx:if="{{mode === 'code2img'}}">
      <view class="file-pick" bindtap="pickFileForMode" data-mode="code2img"><text>选择文件</text></view>
      <textarea class="text-in" placeholder="粘贴图片 Base64 代码..." value="{{decodeInput}}" bindinput="onDecodeInput" />
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{decodeInput}}" bindtap="decodeToImage">转为图片</view>
      <view class="preview" wx:if="{{decodeImagePath}}" bindtap="previewDecodeImg">
        <image class="preview-img" src="{{decodeImagePath}}" mode="aspectFit" />
        <text class="preview-tip">点击预览大图</text>
      </view>
    </block>

    <!-- ========== 批量转换 ========== -->
    <block wx:if="{{mode === 'batch'}}">
      <view class="batch-hint">最多选择 9 张图片，逐个转为 Base64</view>
      <view class="btn" hover-class="btn-press" bindtap="chooseBatchImage">选择图片（最多9张）</view>

      <view class="progress-wrap" wx:if="{{batchConverting}}">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{batchTotal > 0 ? (batchItems.length / batchTotal * 100) : 10}}%"></view>
        </view>
        <text class="progress-text">转换中 {{batchProgress}}</text>
      </view>

      <block wx:if="{{batchItems.length > 0}}">
        <view class="batch-actions">
          <view class="batch-btn" hover-class="btn-press" bindtap="copyAllBatch">
            <text>一键复制全部</text>
          </view>
          <view class="batch-btn batch-btn-save" hover-class="btn-press" bindtap="saveAllBatch">
            <text>批量保存</text>
          </view>
          <view class="batch-btn batch-btn-clear" hover-class="btn-press" bindtap="clearBatch">
            <text>清空</text>
          </view>
        </view>

        <view class="batch-list">
          <view wx:for="{{batchItems}}" wx:key="id" class="batch-card">
            <view class="batch-num">{{index + 1}}</view>
            <image class="batch-thumb" src="{{item.path}}" mode="aspectFill" lazy-load />
            <view class="batch-info">
              <text class="batch-size">{{item.size}}</text>
              <text class="batch-preview">{{item.code}}</text>
            </view>
            <view class="batch-copy" hover-class="btn-press" bindtap="copyBatchItem" data-index="{{index}}">复制</view>
          </view>
        </view>
      </block>
    </block>

    <!-- ========== 二维码生成 ========== -->
    <block wx:if="{{mode === 'qrcode'}}">
      <canvas type="2d" id="qrCanvas" class="qr-canvas"></canvas>
      <view class="qr-hint">输入文字或链接，一键生成二维码</view>
      <textarea class="text-in" placeholder="输入文字或 URL..." value="{{qrInput}}" bindinput="onQrInput" />
      <view class="qr-ec-bar">
        <text class="qr-ec-label">纠错级别</text>
        <view class="qr-ec-opts">
          <text class="qr-ec-opt {{qrEcLevel === 'L' ? 'active' : ''}}" bindtap="setQrEc" data-ec="L">L</text>
          <text class="qr-ec-opt {{qrEcLevel === 'M' ? 'active' : ''}}" bindtap="setQrEc" data-ec="M">M</text>
          <text class="qr-ec-opt {{qrEcLevel === 'Q' ? 'active' : ''}}" bindtap="setQrEc" data-ec="Q">Q</text>
          <text class="qr-ec-opt {{qrEcLevel === 'H' ? 'active' : ''}}" bindtap="setQrEc" data-ec="H">H</text>
        </view>
      </view>
      <view class="btn btn-loading" wx:if="{{qrGenerating}}">生成中...</view>
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{qrInput && !qrGenerating}}" bindtap="generateQR">生成二维码</view>
      <view class="qr-preview" wx:if="{{qrImagePath}}" bindtap="previewQrImage">
        <image class="qr-img" src="{{qrImagePath}}" mode="aspectFit" />
        <text class="preview-tip">点击查看大图</text>
      </view>
      <view class="qr-actions" wx:if="{{qrImagePath}}">
        <view class="qr-action-btn" hover-class="btn-press" bindtap="saveQrImage">保存到相册</view>
        <view class="qr-action-btn qr-action-share" hover-class="btn-press" bindtap="shareQrImage">分享</view>
      </view>
    </block>

    <!-- ========== 图片加水印 ========== -->
    <block wx:if="{{mode === 'watermark'}}">
      <view class="wm-hint">选择图片，添加自定义文字水印</view>
      <view class="btn" hover-class="btn-press" wx:if="{{!wmImagePath}}" bindtap="chooseWmImage">选择图片</view>
      <view class="preview" wx:if="{{wmImagePath}}" bindtap="previewWmResult">
        <image class="preview-img" src="{{wmResultPath || wmImagePath}}" mode="aspectFit" />
        <text class="preview-tip">点击查看大图</text>
      </view>

      <view class="wm-settings" wx:if="{{wmImagePath && !wmProcessing}}">
        <view class="wm-input-group">
          <text class="wm-label">水印文字</text>
          <input class="wm-input" placeholder="输入水印文字" value="{{wmText}}" bindinput="onWmTextInput" />
        </view>

        <view class="wm-row">
          <text class="wm-label">水印位置</text>
          <view class="wm-pos-opts">
            <text class="wm-pos-opt {{wmPosition === 'top-left' ? 'active' : ''}}" bindtap="setWmPosition" data-pos="top-left">左上</text>
            <text class="wm-pos-opt {{wmPosition === 'top-right' ? 'active' : ''}}" bindtap="setWmPosition" data-pos="top-right">右上</text>
            <text class="wm-pos-opt {{wmPosition === 'center' ? 'active' : ''}}" bindtap="setWmPosition" data-pos="center">居中</text>
            <text class="wm-pos-opt {{wmPosition === 'bottom-left' ? 'active' : ''}}" bindtap="setWmPosition" data-pos="bottom-left">左下</text>
            <text class="wm-pos-opt {{wmPosition === 'bottom-right' ? 'active' : ''}}" bindtap="setWmPosition" data-pos="bottom-right">右下</text>
          </view>
        </view>

        <view class="wm-row">
          <text class="wm-label">水印颜色</text>
          <view class="wm-color-opts">
            <view class="wm-color-opt {{wmColor === '#ffffff' ? 'active' : ''}}" style="background: #ffffff;" bindtap="setWmColor" data-color="#ffffff"></view>
            <view class="wm-color-opt {{wmColor === '#000000' ? 'active' : ''}}" style="background: #000000;" bindtap="setWmColor" data-color="#000000"></view>
            <view class="wm-color-opt {{wmColor === '#8B4513' ? 'active' : ''}}" style="background: #8B4513;" bindtap="setWmColor" data-color="#8B4513"></view>
            <view class="wm-color-opt {{wmColor === '#2F4F4F' ? 'active' : ''}}" style="background: #2F4F4F;" bindtap="setWmColor" data-color="#2F4F4F"></view>
            <view class="wm-color-opt {{wmColor === '#4A6FA5' ? 'active' : ''}}" style="background: #4A6FA5;" bindtap="setWmColor" data-color="#4A6FA5"></view>
            <view class="wm-color-opt {{wmColor === '#8B7355' ? 'active' : ''}}" style="background: #8B7355;" bindtap="setWmColor" data-color="#8B7355"></view>
          </view>
        </view>

        <view class="wm-row">
          <text class="wm-label">透明度 {{wmOpacity}}%</text>
          <slider class="wm-slider" min="10" max="100" step="5" value="{{wmOpacity}}" activeColor="#0071E3" bindchange="onWmOpacityChange" />
        </view>

        <view class="wm-row">
          <text class="wm-label">字体大小 {{wmFontSize}}px</text>
          <slider class="wm-slider" min="16" max="80" step="2" value="{{wmFontSize}}" activeColor="#0071E3" bindchange="onWmFontSizeChange" />
        </view>
      </view>

      <view class="btn btn-loading" wx:if="{{wmProcessing}}">处理中...</view>
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{wmImagePath && wmText && !wmProcessing}}" bindtap="addWatermark">添加水印</view>
      <view class="btn" hover-class="btn-press" wx:if="{{wmImagePath && !wmProcessing}}" bindtap="chooseWmImage">重新选择</view>

      <view class="wm-actions" wx:if="{{wmResultPath}}">
        <view class="wm-action-btn" hover-class="btn-press" bindtap="saveWmImage">保存到相册</view>
        <view class="wm-action-btn wm-action-share" hover-class="btn-press" bindtap="shareWmImage">分享</view>
      </view>

      <!-- 隐藏的 Canvas 用于绘制水印 -->
      <canvas type="2d" id="wmCanvas" class="wm-canvas"></canvas>
    </block>

    <!-- ========== 图片格式转换 ========== -->
    <block wx:if="{{mode === 'fmt'}}">
      <view class="fmt-hint">支持 PNG / JPG 格式互转</view>
      <view class="btn" hover-class="btn-press" wx:if="{{!fmtImg}}" bindtap="chooseFmtImg">选择图片</view>
      <view class="preview" wx:if="{{fmtImg}}" bindtap="previewFmtResult">
        <image class="preview-img" src="{{fmtResult || fmtImg}}" mode="aspectFit" />
        <text class="preview-tip">点击查看大图</text>
      </view>

      <view class="fmt-info" wx:if="{{fmtImg && !fmtConverting}}">
        <view class="fmt-row">
          <text class="fmt-label">原始格式</text>
          <text class="fmt-val">{{fmtFrom}}</text>
        </view>
        <view class="fmt-row" wx:if="{{fmtSize}}">
          <text class="fmt-label">文件大小</text>
          <text class="fmt-val">{{fmtSize}}</text>
        </view>
      </view>

      <view class="fmt-bar" wx:if="{{fmtImg && !fmtConverting}}">
        <text class="fmt-bar-label">转换为</text>
        <view class="fmt-opts">
          <text class="fmt-opt {{fmtTo === 'png' ? 'active' : ''}}" bindtap="setFmtTo" data-fmt="png">PNG</text>
          <text class="fmt-opt {{fmtTo === 'jpg' ? 'active' : ''}}" bindtap="setFmtTo" data-fmt="jpg">JPG</text>
        </view>
      </view>

      <view class="btn btn-loading" wx:if="{{fmtConverting}}">转换中...</view>
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{fmtImg && !fmtConverting}}" bindtap="doFmtConvert">开始转换</view>
      <view class="btn" hover-class="btn-press" wx:if="{{fmtImg && !fmtConverting}}" bindtap="chooseFmtImg">重新选择</view>

      <view class="fmt-actions" wx:if="{{fmtResult}}">
        <view class="fmt-btn" hover-class="btn-press" bindtap="saveFmtImg">保存到相册</view>
        <view class="fmt-btn fmt-btn-share" hover-class="btn-press" bindtap="shareFmtImg">分享</view>
      </view>

      <canvas type="2d" id="fmtCanvas" class="fmt-canvas"></canvas>
    </block>

    <!-- ========== 图片尺寸调整 ========== -->
    <block wx:if="{{mode === 'resize'}}">
      <view class="rsz-hint">自定义宽高，支持等比缩放</view>
      <view class="btn" hover-class="btn-press" wx:if="{{!resizeImg}}" bindtap="chooseResizeImg">选择图片</view>
      <view class="preview" wx:if="{{resizeImg}}" bindtap="previewResizeResult">
        <image class="preview-img" src="{{resizeResult || resizeImg}}" mode="aspectFit" />
        <text class="preview-tip">点击查看大图</text>
      </view>

      <view class="rsz-info" wx:if="{{resizeImg && !resizing}}">
        <view class="rsz-row">
          <text class="rsz-label">原始尺寸</text>
          <text class="rsz-val">{{resizeW}} × {{resizeH}}</text>
        </view>
        <view class="rsz-row" wx:if="{{resizeSize}}">
          <text class="rsz-label">文件大小</text>
          <text class="rsz-val">{{resizeSize}}</text>
        </view>
      </view>

      <view class="rsz-inputs" wx:if="{{resizeImg && !resizing}}">
        <view class="rsz-input-group">
          <text class="rsz-input-label">宽度</text>
          <input class="rsz-input" type="number" value="{{resizeNewW}}" bindinput="onResizeW" />
          <text class="rsz-unit">px</text>
        </view>
        <view class="rsz-lock {{resizeRatio ? 'active' : ''}}" bindtap="toggleResizeRatio">
          <text class="lock-txt">{{resizeRatio ? '锁' : '开'}}</text>
        </view>
        <view class="rsz-input-group">
          <text class="rsz-input-label">高度</text>
          <input class="rsz-input" type="number" value="{{resizeNewH}}" bindinput="onResizeH" />
          <text class="rsz-unit">px</text>
        </view>
      </view>

      <view class="btn btn-loading" wx:if="{{resizing}}">处理中...</view>
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{resizeImg && !resizing}}" bindtap="doResize">开始调整</view>
      <view class="btn" hover-class="btn-press" wx:if="{{resizeImg && !resizing}}" bindtap="chooseResizeImg">重新选择</view>

      <view class="rsz-actions" wx:if="{{resizeResult}}">
        <view class="rsz-btn" hover-class="btn-press" bindtap="saveResizeImg">保存到相册</view>
        <view class="rsz-btn rsz-btn-share" hover-class="btn-press" bindtap="shareResizeImg">分享</view>
      </view>

      <canvas type="2d" id="resizeCanvas" class="rsz-canvas"></canvas>
    </block>

    <!-- ========== 图片裁剪 ========== -->
    <block wx:if="{{mode === 'crop'}}">
      <view class="crop-hint">选择裁剪比例，居中裁剪图片</view>
      <view class="btn" hover-class="btn-press" wx:if="{{!cropImg}}" bindtap="chooseCropImg">选择图片</view>
      <view class="preview" wx:if="{{cropImg}}" bindtap="previewCropResult">
        <image class="preview-img" src="{{cropResult || cropImg}}" mode="aspectFit" />
        <text class="preview-tip">点击查看大图</text>
      </view>

      <view class="crop-info" wx:if="{{cropImg && !cropping}}">
        <view class="crop-row">
          <text class="crop-label">原始尺寸</text>
          <text class="crop-val">{{cropW}} × {{cropH}}</text>
        </view>
        <view class="crop-row" wx:if="{{cropSize}}">
          <text class="crop-label">文件大小</text>
          <text class="crop-val">{{cropSize}}</text>
        </view>
      </view>

      <view class="crop-bar" wx:if="{{cropImg && !cropping}}">
        <text class="crop-bar-label">裁剪比例</text>
        <view class="crop-opts">
          <text class="crop-opt {{cropRatio === '1:1' ? 'active' : ''}}" bindtap="setCropRatio" data-ratio="1:1">1:1</text>
          <text class="crop-opt {{cropRatio === '4:3' ? 'active' : ''}}" bindtap="setCropRatio" data-ratio="4:3">4:3</text>
          <text class="crop-opt {{cropRatio === '16:9' ? 'active' : ''}}" bindtap="setCropRatio" data-ratio="16:9">16:9</text>
        </view>
      </view>

      <view class="btn btn-loading" wx:if="{{cropping}}">裁剪中...</view>
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{cropImg && !cropping}}" bindtap="doCrop">开始裁剪</view>
      <view class="btn" hover-class="btn-press" wx:if="{{cropImg && !cropping}}" bindtap="chooseCropImg">重新选择</view>

      <view class="crop-actions" wx:if="{{cropResult}}">
        <view class="crop-btn" hover-class="btn-press" bindtap="saveCropImg">保存到相册</view>
        <view class="crop-btn crop-btn-share" hover-class="btn-press" bindtap="shareCropImg">分享</view>
      </view>

      <canvas type="2d" id="cropCanvas" class="crop-canvas"></canvas>
    </block>

    <!-- ========== 图片旋转 ========== -->
    <block wx:if="{{mode === 'rotate'}}">
      <view class="rot-hint">旋转或翻转图片</view>
      <view class="btn" hover-class="btn-press" wx:if="{{!rotImg}}" bindtap="chooseRotImg">选择图片</view>
      <view class="preview" wx:if="{{rotImg}}" bindtap="previewRotResult">
        <image class="preview-img" src="{{rotResult || rotImg}}" mode="aspectFit" />
        <text class="preview-tip">点击查看大图</text>
      </view>

      <view class="rot-ctrl" wx:if="{{rotImg && !rotating}}">
        <view class="rot-btn" hover-class="btn-press" bindtap="rotLeft">
          <text class="rot-icon">左</text>
          <text class="rot-label">左转90°</text>
        </view>
        <view class="rot-btn" hover-class="btn-press" bindtap="rotRight">
          <text class="rot-icon">右</text>
          <text class="rot-label">右转90°</text>
        </view>
        <view class="rot-btn {{rotFlipH ? 'rot-btn-on' : ''}}" hover-class="btn-press" bindtap="rotFlipH">
          <text class="rot-icon">水平</text>
          <text class="rot-label">水平翻转</text>
        </view>
        <view class="rot-btn {{rotFlipV ? 'rot-btn-on' : ''}}" hover-class="btn-press" bindtap="rotFlipV">
          <text class="rot-icon">垂直</text>
          <text class="rot-label">垂直翻转</text>
        </view>
      </view>

      <view class="rot-info" wx:if="{{rotImg && !rotating}}">
        <text class="rot-angle">当前旋转：{{rotDeg}}°</text>
      </view>

      <view class="btn btn-loading" wx:if="{{rotating}}">处理中...</view>
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{rotImg && !rotating}}" bindtap="doRotate">应用变换</view>
      <view class="btn" hover-class="btn-press" wx:if="{{rotImg && !rotating}}" bindtap="chooseRotImg">重新选择</view>

      <view class="rot-actions" wx:if="{{rotResult}}">
        <view class="rot-save" hover-class="btn-press" bindtap="saveRotImg">保存到相册</view>
        <view class="rot-share" hover-class="btn-press" bindtap="shareRotImg">分享</view>
      </view>

      <canvas type="2d" id="rotCanvas" class="rot-canvas"></canvas>
    </block>

    <!-- ========== 颜色提取 ========== -->
    <block wx:if="{{mode === 'color'}}">
      <view class="clr-hint">从图片中提取主色调色板</view>
      <view class="btn" hover-class="btn-press" wx:if="{{!colorImg}}" bindtap="chooseColorImg">选择图片</view>
      <view class="preview" wx:if="{{colorImg}}" bindtap="previewColorImg">
        <image class="preview-img" src="{{colorImg}}" mode="aspectFit" />
        <text class="preview-tip">点击查看大图</text>
      </view>

      <view class="btn btn-loading" wx:if="{{colorPicking}}">提取中...</view>
      <view class="btn" hover-class="btn-press" wx:if="{{colorImg && !colorPicking}}" bindtap="chooseColorImg">重新选择</view>

      <view class="clr-palette" wx:if="{{colorList.length > 0}}">
        <text class="clr-title">主色调色板</text>
        <view wx:for="{{colorList}}" wx:key="id" class="clr-item" bindtap="copyColorHex" data-hex="{{item.hex}}">
          <view class="clr-swatch" style="background: {{item.hex}};"></view>
          <view class="clr-info">
            <text class="clr-hex">{{item.hex}}</text>
            <text class="clr-rgb">RGB({{item.r}},{{item.g}},{{item.b}})</text>
          </view>
          <text class="clr-pct">{{item.pct}}%</text>
        </view>
      </view>

      <canvas type="2d" id="colorCanvas" class="clr-canvas"></canvas>
    </block>

    <!-- ========== 图片马赛克 ========== -->
    <block wx:if="{{mode === 'mosaic'}}">
      <view class="mos-hint">对图片添加马赛克像素化效果</view>
      <view class="btn" hover-class="btn-press" wx:if="{{!mosaicImg}}" bindtap="chooseMosaicImg">选择图片</view>
      <view class="preview" wx:if="{{mosaicImg}}" bindtap="previewMosaicResult">
        <image class="preview-img" src="{{mosaicResult || mosaicImg}}" mode="aspectFit" />
        <text class="preview-tip">点击查看大图</text>
      </view>

      <view class="mos-bar" wx:if="{{mosaicImg && !mosaicing}}">
        <text class="mos-label">马赛克强度</text>
        <view class="mos-opts">
          <text class="mos-opt {{mosaicLevel === 4 ? 'active' : ''}}" bindtap="setMosaicLevel" data-level="4">轻度</text>
          <text class="mos-opt {{mosaicLevel === 8 ? 'active' : ''}}" bindtap="setMosaicLevel" data-level="8">中度</text>
          <text class="mos-opt {{mosaicLevel === 16 ? 'active' : ''}}" bindtap="setMosaicLevel" data-level="16">重度</text>
          <text class="mos-opt {{mosaicLevel === 32 ? 'active' : ''}}" bindtap="setMosaicLevel" data-level="32">极强</text>
        </view>
      </view>

      <view class="btn btn-loading" wx:if="{{mosaicing}}">处理中...</view>
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{mosaicImg && !mosaicing}}" bindtap="doMosaic">添加马赛克</view>
      <view class="btn" hover-class="btn-press" wx:if="{{mosaicImg && !mosaicing}}" bindtap="chooseMosaicImg">重新选择</view>

      <view class="mos-actions" wx:if="{{mosaicResult}}">
        <view class="mos-save" hover-class="btn-press" bindtap="saveMosaicImg">保存到相册</view>
        <view class="mos-share" hover-class="btn-press" bindtap="shareMosaicImg">分享</view>
      </view>

      <canvas type="2d" id="mosaicCanvas" class="mos-canvas"></canvas>
    </block>

    <!-- ========== 图片压缩 ========== -->
    <block wx:if="{{mode === 'compress'}}">
      <view class="compress-hint">选择图片，压缩大小后保存或分享</view>
      <view class="btn" hover-class="btn-press" wx:if="{{!compressImagePath}}" bindtap="chooseCompressImage">选择图片</view>
      <view class="preview" wx:if="{{compressImagePath}}" bindtap="previewCompressResult">
        <image class="preview-img" src="{{compressResultPath || compressImagePath}}" mode="aspectFit" />
        <text class="preview-tip">点击查看大图</text>
      </view>

      <view class="compress-info" wx:if="{{compressImagePath && !compressing}}">
        <view class="compress-info-row">
          <text class="compress-info-label">原始大小</text>
          <text class="compress-info-value">{{compressOrigSize}}</text>
        </view>
        <view class="compress-info-row" wx:if="{{compressNewSize}}">
          <text class="compress-info-label">压缩后</text>
          <text class="compress-info-value compress-highlight">{{compressNewSize}}</text>
        </view>
        <view class="compress-info-row" wx:if="{{compressRatio !== '' && compressRatio !== '0'}}">
          <text class="compress-info-label">{{compressRatio < 0 ? '增大' : '减小'}}</text>
          <text class="compress-info-value {{compressRatio < 0 ? 'compress-warn' : 'compress-ratio'}}">{{compressRatio < 0 ? -compressRatio : compressRatio}}%</text>
        </view>
      </view>

      <view class="quality-bar" wx:if="{{compressImagePath && !compressing}}">
        <text class="quality-label">压缩质量</text>
        <view class="quality-opts">
          <text class="quality-opt {{compressQualityLevel === 20 ? 'active' : ''}}" bindtap="setCompressQuality" data-q="20">极低</text>
          <text class="quality-opt {{compressQualityLevel === 40 ? 'active' : ''}}" bindtap="setCompressQuality" data-q="40">低</text>
          <text class="quality-opt {{compressQualityLevel === 60 ? 'active' : ''}}" bindtap="setCompressQuality" data-q="60">中</text>
          <text class="quality-opt {{compressQualityLevel === 80 ? 'active' : ''}}" bindtap="setCompressQuality" data-q="80">高</text>
        </view>
      </view>

      <view class="progress-wrap" wx:if="{{compressing}}">
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{compressProgress}}%"></view>
        </view>
        <text class="progress-text">{{compressStage}}</text>
      </view>

      <view class="btn btn-loading" wx:if="{{compressing}}">压缩中...</view>
      <view class="btn btn-cvt" hover-class="btn-press" wx:if="{{compressImagePath && !compressing}}" bindtap="doCompress">开始压缩</view>
      <view class="btn" hover-class="btn-press" wx:if="{{compressImagePath && !compressing}}" bindtap="chooseCompressImage">重新选择</view>

      <view class="compress-actions" wx:if="{{compressResultPath}}">
        <view class="compress-action-btn" hover-class="btn-press" bindtap="saveCompressedImage">保存到相册</view>
        <view class="compress-action-btn compress-action-share" hover-class="btn-press" bindtap="shareCompressedImage">分享</view>
      </view>
    </block>

    <view class="fab" hover-class="fab-press" bindtap="showMenu" wx:if="{{!menuShow && !filesShow}}">
      <text class="fab-txt">+</text>
    </view>
    <view class="mask" wx:if="{{menuShow}}" bindtap="hideMenu"></view>
    <view class="menu" wx:if="{{menuShow}}">
      <view class="menu-hd">
        <text class="menu-title">选择功能</text>
      </view>
      <view class="menu-grid">
        <view class="menu-card" hover-class="menu-card-press" bindtap="startImg2Code">
          <view class="menu-card-icon"><text>图</text></view>
          <text class="menu-card-label">图片转代码</text>
        </view>
        <view class="menu-card" hover-class="menu-card-press" bindtap="startCode2Img">
          <view class="menu-card-icon"><text>码</text></view>
          <text class="menu-card-label">代码转图片</text>
        </view>
        <view class="menu-card" hover-class="menu-card-press" bindtap="startText2Code">
          <view class="menu-card-icon"><text>文</text></view>
          <text class="menu-card-label">文字转代码</text>
        </view>
        <view class="menu-card" hover-class="menu-card-press" bindtap="startCode2Text">
          <view class="menu-card-icon"><text>码</text></view>
          <text class="menu-card-label">代码转文字</text>
        </view>
        <view class="menu-card" hover-class="menu-card-press" bindtap="startBatchImg">
          <view class="menu-card-icon"><text>批</text></view>
          <text class="menu-card-label">批量转换</text>
        </view>
        <view class="menu-card" hover-class="menu-card-press" bindtap="startQrCode">
          <view class="menu-card-icon"><text>码</text></view>
          <text class="menu-card-label">生成二维码</text>
        </view>
        <view class="menu-card" hover-class="menu-card-press" bindtap="startCompress">
          <view class="menu-card-icon"><text>压</text></view>
          <text class="menu-card-label">图片压缩</text>
        </view>
        <view class="menu-card" hover-class="menu-card-press" bindtap="startWatermark">
          <view class="menu-card-icon"><text>水</text></view>
          <text class="menu-card-label">图片加水印</text>
        </view>
        <view class="menu-card" hover-class="menu-card-press" bindtap="startFmt">
          <view class="menu-card-icon"><text>格</text></view>
          <text class="menu-card-label">格式转换</text>
        </view>
        <view class="menu-card" hover-class="menu-card-press" bindtap="startResize">
          <view class="menu-card-icon"><text>尺</text></view>
          <text class="menu-card-label">尺寸调整</text>
        </view>
        <view class="menu-card" hover-class="menu-card-press" bindtap="startCrop">
          <view class="menu-card-icon"><text>裁</text></view>
          <text class="menu-card-label">图片裁剪</text>
        </view>
        <view class="menu-card" hover-class="menu-card-press" bindtap="startRotate">
          <view class="menu-card-icon"><text>旋</text></view>
          <text class="menu-card-label">旋转翻转</text>
        </view>
        <view class="menu-card" hover-class="menu-card-press" bindtap="startColor">
          <view class="menu-card-icon"><text>色</text></view>
          <text class="menu-card-label">提取颜色</text>
        </view>
        <view class="menu-card" hover-class="menu-card-press" bindtap="startMosaic">
          <view class="menu-card-icon"><text>马</text></view>
          <text class="menu-card-label">图片马赛克</text>
        </view>
      </view>
      <view class="menu-cancel" bindtap="hideMenu">取消</view>
    </view>

    <view wx:if="{{images.length > 0}}" class="history">
      <text class="h-title">历史记录</text>
      <scroll-view class="h-list" scroll-x enhanced show-scrollbar="{{false}}">
        <view wx:for="{{images}}" wx:key="id" class="h-item" wx:if="{{index < 20}}">
          <view class="h-item-main" bindtap="loadHistory" data-index="{{index}}">
            <image wx:if="{{item.type === 'image'}}" class="h-img" src="{{item.path}}" mode="aspectFill" lazy-load />
            <view wx:else class="h-text-card">
              <text class="h-text-preview">{{item.preview}}</text>
            </view>
          </view>
          <view class="h-item-ft">
            <text class="h-size">{{item.size || '未转'}}</text>
            <text class="h-copy" catchtap="copyHistoryCode" data-index="{{index}}">复制</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
  </block>

  <!-- 文件浏览弹窗 -->
  <view class="files-mask" wx:if="{{filesShow}}" bindtap="closeFiles"></view>
  <view class="files-modal" wx:if="{{filesShow}}">
    <view class="files-hd"><text class="files-title">保存的文件</text><text class="files-close" bindtap="closeFiles">×</text></view>
    <scroll-view class="files-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:for="{{filesList}}" wx:key="name" class="files-item" bindtap="openFile" data-index="{{index}}">
        <text class="files-name">{{item.name}}</text>
        <text class="files-arrow">›</text>
      </view>
      <view wx:if="{{filesLoading}}" class="files-empty">加载中...</view>
      <view wx:if="{{!filesLoading && filesList.length === 0}}" class="files-empty">暂无文件</view>
    </scroll-view>
  </view>
</view>
