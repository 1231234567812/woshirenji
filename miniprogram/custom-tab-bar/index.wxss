.tab-bar {
  position: fixed;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  left: 48rpx;
  right: 48rpx;
  height: 120rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.08), 0 1rpx 0 rgba(255,255,255,0.6) inset;
  overflow: hidden;
  z-index: 9999;
  border: 1rpx solid rgba(255,255,255,0.5);
}

.bubble {
  position: absolute;
  top: 16rpx;
  width: 38%;
  height: 88rpx;
  border-radius: 24rpx;
  background: rgba(0, 113, 227, 0.1);
  box-shadow: 0 0 24rpx rgba(0, 113, 227, 0.08);
  transition: left 0.2s ease;
  border: 1rpx solid rgba(0,113,227,0.08);
}

.bubble-0 { left: 6%; }
.bubble-1 { left: 56%; }

.tab-item {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 120rpx;
  transition: transform 0.2s ease;
}

.tab-item:active { transform: scale(0.92); }

.tab-icon-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 6rpx;
}
.tab-icon {
  position: absolute;
  top: 0;
  left: 0;
  width: 48rpx;
  height: 48rpx;
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.icon-show { opacity: 1; transform: scale(1); }
.icon-hide { opacity: 0; transform: scale(0.7); }

.tab-text {
  font-size: 22rpx;
  color: #86868B;
  font-weight: 500;
  transition: color 0.2s ease;
}

.tab-text.on {
  color: #0071E3;
  font-weight: 700;
}

/* Dark */
.tab-bar.dark {
  background: rgba(28, 28, 30, 0.9);
  border: 1rpx solid rgba(255,255,255,0.06);
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.08), 0 1rpx 0 rgba(255,255,255,0.04) inset;
}
.bubble.dark {
  background: rgba(10, 132, 255, 0.15);
  box-shadow: 0 0 24rpx rgba(10, 132, 255, 0.08);
  border: 1rpx solid rgba(10,132,255,0.12);
}
.dark .tab-text { color: #98989D; }
.dark .tab-text.on { color: #0A84FF; }
