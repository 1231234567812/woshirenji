.tab-bar {
  position: fixed;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  left: 60rpx;
  right: 60rpx;
  height: 110rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  border-radius: 40rpx;
  background: rgba(241, 250, 238, 0.82);
  box-shadow: 0 4rpx 32rpx rgba(29, 53, 87, 0.1);
  overflow: hidden;
  z-index: 9999;
}

.bubble {
  position: absolute;
  top: 13rpx;
  width: 40%;
  height: 84rpx;
  border-radius: 24rpx;
  background: rgba(168, 218, 220, 0.82);
  box-shadow: 0 0 24rpx rgba(69, 123, 157, 0.35), 0 0 48rpx rgba(168, 218, 220, 0.25);
  transition: left 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.bubble-0 { left: 5%; }
.bubble-1 { left: 55%; }

.tab-item {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 110rpx;
}

.tab-icon-wrap {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 4rpx;
}
.tab-icon {
  position: absolute;
  top: 0;
  left: 0;
  width: 44rpx;
  height: 44rpx;
  transition: opacity 0.35s ease;
}
.icon-show { opacity: 1; }
.icon-hide { opacity: 0; }

.tab-text {
  font-size: 22rpx;
  color: #999;
}

.tab-text.on {
  color: #457b9d;
  font-weight: 600;
}

/* 深色 */
.tab-bar.dark { background: rgba(22, 33, 62, 0.92); }
.bubble.dark { background: rgba(69, 123, 157, 0.5); box-shadow: none; }
